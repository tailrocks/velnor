+
+        let empty = BTreeMap::new();
+        let mut explicit_empty = BTreeMap::new();
+        explicit_empty.insert("EMPTY_FLAG".to_owned(), String::new());
+        assert_eq!(
+            unit_workflow_file(UnitKind::Rust, &empty),
