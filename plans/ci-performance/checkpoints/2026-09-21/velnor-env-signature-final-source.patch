+    #[test]
+    fn unit_environment_identity_is_stable_and_presence_sensitive() {
+        let mut first = BTreeMap::new();
+        first.insert("Z_FLAG".to_owned(), "same".to_owned());
+        first.insert("A_FLAG".to_owned(), "value".to_owned());
+        let mut reordered = BTreeMap::new();
+        reordered.insert("A_FLAG".to_owned(), "value".to_owned());
