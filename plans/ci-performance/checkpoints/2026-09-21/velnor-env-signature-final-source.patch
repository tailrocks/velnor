+/// Return the reusable workflow path for the exact environment exported by a
+/// unit. Presence is significant: an absent key and a key whose value is empty
+/// are different maps and therefore different workflow contracts.
+pub(crate) fn unit_workflow_file(kind: UnitKind, env: &BTreeMap<String, String>) -> String {
+    workflow_file_for_kind_id(kind.id_prefix(), env)
+}
+
+pub(crate) fn workflow_file_for_kind_id(kind_id: &str, env: &BTreeMap<String, String>) -> String {
+    if env.is_empty() {
+        return format!("ci-unit-{kind_id}.yml");
+    }
+    format!("ci-unit-{kind_id}-env-{}.yml", unit_env_digest(env))
+}
+
+pub(crate) fn workflow_file_kind_id(file: &str) -> Option<&str> {
+    let stem = file
+        .strip_prefix("ci-unit-")
+        .and_then(|value| value.strip_suffix(".yml"))?;
+    match stem.split_once("-env-") {
+        Some((kind, digest))
+            if digest.len() == 64 && digest.bytes().all(|byte| byte.is_ascii_hexdigit()) =>
+        {
+            Some(kind)
+        }
+        Some(_) => None,
+        None => Some(stem),
+    }
+}
+
+/// Canonical, versioned environment identity. `BTreeMap` ordering plus explicit
+/// lengths prevents insertion order, delimiter, and prefix ambiguities from
+/// changing or colliding the partition identity.
+pub(crate) fn unit_env_digest(env: &BTreeMap<String, String>) -> String {
+    let mut canonical = Vec::from(*b"velnor-unit-env-v1\0");
+    for (name, value) in env {
+        canonical.extend_from_slice(&(name.len() as u64).to_be_bytes());
+        canonical.extend_from_slice(name.as_bytes());
+        canonical.extend_from_slice(&(value.len() as u64).to_be_bytes());
+        canonical.extend_from_slice(value.as_bytes());
+    }
+    let mut digest = String::with_capacity(64);
+    for byte in Sha256::digest(canonical) {
+        let _ = write!(digest, "{byte:02x}");
+    }
+    digest
+}
+
+/// Partition members by the complete effective environment. `BTreeMap` ordering
+/// makes both filenames and generated bytes deterministic while retaining the
+/// original unit order inside each partition.
+pub(crate) fn unit_env_partitions<'a>(
+    members: &[&'a Unit],
+) -> Vec<(BTreeMap<String, String>, Vec<&'a Unit>)> {
+    partition_by_env(members, |member| &member.env)
+}
+
+pub(crate) fn partition_by_env<'a, T, F>(
+    members: &[&'a T],
+    env_of: F,
+) -> Vec<(BTreeMap<String, String>, Vec<&'a T>)>
+where
+    F: Fn(&T) -> &BTreeMap<String, String>,
+{
+    let mut partitions = BTreeMap::<BTreeMap<String, String>, Vec<&'a T>>::new();
+    for member in members {
+        partitions
+            .entry(env_of(member).clone())
+            .or_default()
+            .push(*member);
+    }
+    partitions.into_iter().collect()
+}
+
+/// Enforce GitHub's reusable-workflow path budget from the rendered caller
+/// graph. Unit configuration is not itself a caller: adopted surfaces may
+/// render no unit workflows, while static callers may consume other reusable
+/// workflows. Inspect each workflow's top-level `jobs.<id>.uses` values after
+/// rendering and fail before the in-memory surface can be written.
+pub(crate) fn validate_rendered_reusable_workflow_call_budget(
+    files: &BTreeMap<PathBuf, String>,
+) -> Result<(), GeneratorError> {
+    const GITHUB_UNIQUE_REUSABLE_WORKFLOW_LIMIT: usize = 50;
+    for (path, content) in files {
+        if !matches!(
+            path.extension().and_then(|extension| extension.to_str()),
+            Some("yml" | "yaml")
+        ) {
+            continue;
+        }
+        let document: Value = serde_yaml::from_str(content).map_err(|error| {
+            GeneratorError::usage(format!(
+                "cannot inspect reusable-workflow calls in `{}`: {error}",
+                path.display()
+            ))
+        })?;
+        let Some(jobs) = document
+            .as_mapping()
+            .and_then(|document| document.get("jobs"))
+        else {
+            continue;
+        };
+        let Some(jobs) = jobs.as_mapping() else {
+            return Err(GeneratorError::usage(format!(
+                "workflow `{}` has a non-mapping `jobs` value; reusable-workflow limits cannot be proven",
+                path.display()
+            )));
+        };
+        let mut callers = BTreeSet::new();
+        for (job_id, job) in jobs {
+            let Some(job) = job.as_mapping() else {
+                continue;
+            };
+            let Some(uses) = job.get("uses") else {
+                continue;
+            };
+            let Some(uses) = uses.as_str() else {
+                return Err(GeneratorError::usage(format!(
+                    "workflow `{}` job `{}` has a non-string reusable-workflow `uses` value",
+                    path.display(),
+                    job_id,
+                )));
+            };
+            if uses.contains("${{") {
+                return Err(GeneratorError::usage(format!(
+                    "workflow `{}` job `{}` computes a reusable-workflow path dynamically; the 50-path caller limit cannot be proven",
+                    path.display(),
+                    job_id,
+                )));
+            }
+            callers.insert(uses.to_owned());
+        }
+        if callers.len() > GITHUB_UNIQUE_REUSABLE_WORKFLOW_LIMIT {
+            return Err(GeneratorError::usage(format!(
+                "workflow `{}` calls {} unique reusable workflows; GitHub permits at most {} per caller, so generation stops before emitting a partial surface",
+                path.display(),
+                callers.len(),
+                GITHUB_UNIQUE_REUSABLE_WORKFLOW_LIMIT
+            )));
+        }
+    }
+    Ok(())
 }
 
