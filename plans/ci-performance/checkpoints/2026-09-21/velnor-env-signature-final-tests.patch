     fn project(&self) -> String {
         fs::read_to_string(self.output.join(".github/ci/project.toml")).unwrap()
+    }
+
+    fn workflow_kind(&self, kind: &str) -> String {
+        let directory = self.output.join(".github/workflows");
+        let prefix = format!("ci-unit-{kind}");
+        let mut matches = fs::read_dir(&directory)
+            .unwrap()
+            .filter_map(Result::ok)
+            .filter_map(|entry| {
+                let name = entry.file_name().into_string().ok()?;
+                (name.starts_with(&prefix) && name.ends_with(".yml")).then_some(name)
+            })
+            .collect::<Vec<_>>();
+        matches.sort();
+        assert_eq!(
+            matches.len(),
+            1,
+            "fixture must expose exactly one {kind} partition; found {matches:?}"
+        );
+        self.workflow(&matches[0])
     }
 }
 
