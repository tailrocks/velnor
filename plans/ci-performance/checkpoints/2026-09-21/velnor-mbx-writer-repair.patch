+/// The only untrusted event allowed to write the Mr. Boxington GitHub cache.
+///
+/// A normal `pull_request` run gets a merge-ref cache namespace. A fork run
+/// still gets restore access, but its head repository must not write into the
+/// base repository's cache namespace. `pull_request_target` is deliberately
+/// absent: it runs privileged workflow code from the base tree and is never a
+/// writer transport for PR code.
+fn same_repository_pull_request_gate() -> &'static str {
+    "github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository && github.event.pull_request.head.sha != ''"
+}
+
+/// Export and save the current Mr. Boxington object closure for a successful
+/// same-repository PR.
+///
+/// The action's post step intentionally remains restore-only for PR events.
+/// This explicit writer runs after checks, so the ordinary PR cache remains
+/// merge-ref scoped while a later run can restore the exact source snapshot.
+/// The action/cache key is immutable: an exact hit skips the writer and a
+/// concurrent save failure is reported without turning a cache optimization
+/// into a required-check failure.
+fn render_mbx_pr_cache_writer(
+    output: &mut String,
+    cache_save_pin: &str,
+    mode: MrBoxingtonGithubCacheMode,
+) {
+    let Some(archive_dir) = mode.object_bundle_dir() else {
+        return;
+    };
+    let gate = format!(
+        "success() && ({}) && steps.mbx-cache.outputs.cache-hit == 'false' && steps.mbx-cache.outputs.cache-primary-key != ''",
+        same_repository_pull_request_gate()
+    );
+    render_phase_epoch_marker_if(
+        output,
+        "CACHE_PR_EXPORT_STARTED",
+        "Mark PR Mr. Boxington export start",
+        &format!("always() && ({gate})"),
+    );
+    let _ = writeln!(
+        output,
+        "      - name: Export PR Mr. Boxington cache\n        id: mbx_pr_export\n        if: {gate}\n        continue-on-error: true\n        shell: bash\n        env:\n          MBX_PR_CACHE_MODE: {mode}\n        run: |\n          set -u -o pipefail\n          status=missing_export_group\n          archive=\n          archive_kib=0\n          if [[ \"$MBX_PR_CACHE_MODE\" != objects ]]; then\n            status=unsupported_cache_mode\n          elif [[ \"${{MBX_REMOTE_MODE:-}}\" == read-only ]]; then\n            status=read_only\n          elif [[ -z \"${{MBX_CACHE_EXPORT_GROUP:-}}\" ]]; then\n            status=missing_export_group\n          elif ! store_dir=\"$(mbx cache dir)\"; then\n            status=missing_store\n          else\n            archive=\"$store_dir/{archive_dir}\"\n            if mbx cache export --group \"$MBX_CACHE_EXPORT_GROUP\" --format directory \"$archive\"; then\n              if [[ -d \"$archive\" ]]; then\n                status=exported\n                archive_kib=\"$(du -sk \"$archive\" 2>/dev/null | awk '{{print $1}}' || echo 0)\"\n              else\n                status=empty_export\n              fi\n            else\n              status=export_failed\n            fi\n          fi\n          {{\n            echo \"status=$status\"\n            echo \"cache_path=$archive\"\n            echo \"archive_kib=$archive_kib\"\n          }} >> \"$GITHUB_OUTPUT\"\n          echo \"PR Mr. Boxington export: status=$status archive_kib=$archive_kib\"",
+        mode = mode.as_str(),
+        archive_dir = archive_dir,
+    );
+    let export_end_gate =
+        format!("always() && ({gate}) && steps.mbx_pr_export.outcome != 'skipped'");
+    render_phase_epoch_marker_if(
+        output,
+        "CACHE_PR_EXPORT_ENDED",
+        "Mark PR Mr. Boxington export end",
+        &export_end_gate,
+    );
+    let save_gate = format!(
+        "success() && ({}) && steps.mbx-cache.outputs.cache-hit == 'false' && steps.mbx-cache.outputs.cache-primary-key != '' && steps.mbx_pr_export.outputs.status == 'exported'",
+        same_repository_pull_request_gate()
+    );
+    let save_start_gate = format!("always() && ({save_gate})");
+    render_phase_epoch_marker_if(
+        output,
+        "CACHE_PR_SAVE_STARTED",
+        "Mark PR Mr. Boxington save start",
+        &save_start_gate,
+    );
+    let _ = writeln!(
+        output,
+        "      - name: Save PR Mr. Boxington cache\n        id: mbx_pr_save\n        if: {save_gate}\n        continue-on-error: true\n        uses: {cache_save_pin}\n        with:\n          path: ${{{{ steps.mbx_pr_export.outputs.cache_path }}}}\n          key: ${{{{ steps.mbx-cache.outputs.cache-primary-key }}}}"
