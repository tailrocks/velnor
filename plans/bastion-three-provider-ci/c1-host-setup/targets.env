# shellcheck shell=bash
# C1 bastion inventory entry (shell form of the hosts.ini [nodes] pattern).
# Source shape: ChainArgos/java-monorepo ansible-configs/hosts.ini @ 218a44b2:
#   [nodes] entries with ansible_ssh_user=root and
#   ansible_ssh_common_args='-o IdentitiesOnly=no -o StrictHostKeyChecking=accept-new'.
# Sourced by provision-bastion.sh for display only; the script never SSHes itself.
# Every value may be overridden from the environment.

: "${VELNOR_C1_TARGET_NAME:=bastion}"
: "${VELNOR_C1_TARGET_HOST:=37.27.110.241}"
: "${VELNOR_C1_TARGET_USER:=root}"
: "${VELNOR_C1_TARGET_ARCH:=amd64}"
: "${VELNOR_C1_TARGET_DIST:=trixie}"
: "${VELNOR_C1_SSH_OPTS:=-o IdentitiesOnly=no -o StrictHostKeyChecking=accept-new}"
