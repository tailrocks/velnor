# shellcheck shell=bash
# C1 bastion inventory entry. Sourced for display only; the provisioner never
# makes SSH connections. The control host must use an operator-provided,
# pre-authenticated known_hosts file and StrictHostKeyChecking=yes.
# Every target value may be overridden from the environment.

: "${VELNOR_C1_TARGET_NAME:=bastion}"
: "${VELNOR_C1_TARGET_HOST:=37.27.110.241}"
: "${VELNOR_C1_TARGET_USER:=root}"
: "${VELNOR_C1_TARGET_ARCH:=amd64}"
: "${VELNOR_C1_TARGET_DIST:=trixie}"
