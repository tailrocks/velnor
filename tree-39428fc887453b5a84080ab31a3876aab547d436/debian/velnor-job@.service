[Unit]
Description=Velnor job worker %i (transient job unit)
Documentation=https://github.com/tailrocks/velnor
# Transient unit; not PartOf the controller.

[Service]
Type=notify
WatchdogSec=30
KillMode=control-group
Slice=velnor-jobs.slice
Environment=VELNOR_CAPABILITY_VALIDATION=strict
EnvironmentFile=/etc/velnor/velnor.env
Environment=MISE_LOCKFILE=1
Environment=MISE_LOCKED=1
Environment=MISE_LOCKED_VERIFY_PROVENANCE=1
ExecStart=/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnor-runner job --state-dir /var/lib/velnor --job-id %i
Restart=no
TimeoutStartSec=0
TimeoutStopSec=600
User=root
StateDirectory=velnor
RuntimeDirectory=velnor
WorkingDirectory=/var/lib/velnor
ReadWritePaths=/var/lib/velnor /run/velnor /var/log/velnor /var/cache/velnor
