[Unit]
Description=Velnor fleet health probe
Documentation=https://github.com/tailrocks/velnor
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=VELNOR_STORAGE_ROOT=/var
EnvironmentFile=/etc/velnor/velnor.env
EnvironmentFile=-/etc/velnor/secrets.env
# Same StateDirectory as velnor-daemon.service so STATE_DIRECTORY wins over
# VELNOR_STORAGE_ROOT. Never $HOME/.velnor.
StateDirectory=velnor
RuntimeDirectory=velnor
ExecStart=/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnorctl doctor \
  --url ${VELNOR_URL} \
  --name ${VELNOR_NAME} \
  --slots ${VELNOR_SLOTS}
