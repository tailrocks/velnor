# Velnor runner configuration.
# Edit, then:  sudo systemctl restart velnor-daemon
#
# After editing, the runner registers JIT GitHub runners against VELNOR_URL using
# GITHUB_TOKEN and starts polling for jobs.

# GitHub token for runner registration lives in /etc/velnor/secrets.env
# (0600, operator-owned, never shipped or modified by the package):
#   GITHUB_TOKEN=ghp_...
# Leaving it here also works (secrets.env wins if both are set), but the
# separate file survives package upgrades and config tooling.
GITHUB_TOKEN=

# Repository, org, or enterprise URL to register runners against.
VELNOR_URL=https://github.com/OWNER/REPO

# Base runner display name (each slot appends -slot-N).
VELNOR_NAME=velnor

# Comma-separated runner labels. Jobs target these via runs-on.
VELNOR_LABELS=velnor,velnor-target-mvp

# Restricted organization/enterprise runner group. Prefer the stable name;
# Velnor resolves its current numeric id before requesting each JIT config.
#VELNOR_POOL_NAME=velnor-trusted
#VELNOR_POOL_ID=3

# Explicit desired group/repository/label/trust policy JSON for organization
# daemons. Live GitHub evidence is never promoted to policy automatically.
#VELNOR_ROUTING_POLICY_FILE=/etc/velnor/tailrocks-routing-policy.json

# Number of concurrent job slots.
VELNOR_SLOTS=4

# Execution backend is NOT an env var. Set it in /etc/velnor/execution.toml:
#   [execution]
#   backend = "docker"   # or "microvm"
# There is no automatic fallback between backends.

# Trust boundary for this daemon/pool. Use one value per trust boundary (for
# example: untrusted, public-forks, trusted). It gates the shared Docker socket,
# privileged container options, privileged service containers, host port
# publishing, user secrets, and the namespace of every persistent store
# (cargo/mise executables, compiler caches, target buckets, git mirrors).
#
# Only the exact value "trusted" grants host-level capability, and trust fails
# closed: this ships as untrusted, and a pool that genuinely runs only
# first-party code must be raised deliberately. Never set this to "trusted" on a
# pool that accepts fork pull requests — a fork job would then write into the
# stores the next job mounts read-write onto its PATH.
VELNOR_TRUST_SCOPE=untrusted

# Default Docker resource cap per job container. Operators can tune these per
# daemon instance; empty values disable the matching cap.
VELNOR_JOB_CPUS=4
VELNOR_JOB_MEMORY=12g

# Host work directory for job state.
VELNOR_WORK_DIR=/var/lib/velnor/work

# Optional / advanced settings.
#
# Store runner credentials somewhere other than $HOME/.velnor/runner. Keep this
# directory private (0700); runner credentials are written 0600.
#VELNOR_CONFIG_DIR=/var/lib/velnor/config
#
# Logging/tracing. VELNOR_LOG uses Rust tracing filter syntax; OTLP export
# requires a build with the "otel" cargo feature.
#VELNOR_LOG=velnor_runner=info
#VELNOR_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# GitHub JSON transport. Native is the only supported production transport and
# uses one pooled reqwest client.
VELNOR_GITHUB_HTTP_TRANSPORT=native
#
# Persist Rust target dirs across jobs. Safe sharing boundary is
# VELNOR_TRUST_SCOPE + repository + workflow + job class.
#VELNOR_CARGO_TARGET_PERSIST=false
#
# Allow workflow container.options that grant host-level privileges. Leave off
# except for an intentionally trusted daemon scope.
#VELNOR_ALLOW_PRIVILEGED_OPTIONS=false
#
# Smoke-script / doctor knobs consumed by Velnor's helper scripts.
#VELNOR_REQUIRE_DOCKER_SOCKET=true
#VELNOR_IDLE_TIMEOUT_SECONDS=900
#
# Capability admission mode. The packaged units set
# VELNOR_CAPABILITY_VALIDATION=strict, which is the only supported value: every
# job is transitively admitted before any side effect and admission cannot be
# bypassed. Setting a non-strict value, or the removed
# VELNOR_SKIP_CAPABILITY_VALIDATION / VELNOR_DIAGNOSTIC_NODE_SIDECAR variables,
# makes the daemon refuse to start.
VELNOR_CAPABILITY_VALIDATION=strict

# mise must refuse lockfile drift in every runner-owned job. The packaged
# systemd units and runner code reassert these values after workflow env input.
MISE_LOCKFILE=1
MISE_LOCKED=1
MISE_LOCKED_VERIFY_PROVENANCE=1
