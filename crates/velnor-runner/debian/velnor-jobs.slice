[Unit]
Description=Velnor job-worker slice
Documentation=https://github.com/tailrocks/velnor
# postinst writes this host-specific CPUQuota drop-in atomically. Do not let
# Docker create a supposedly protected parent with the package default absent.
AssertPathExists=/etc/systemd/system/velnor-jobs.slice.d/10-host-cpu.conf

[Slice]
# postinst derives CPUQuota as 95% of the detected online logical CPUs. The
# drop-in is required above so this slice never silently falls back to a fixed
# 20-CPU assumption or an uncapped host.
CPUWeight=100
IOWeight=100
# Keep job memory below 95% of installed RAM while throttling before the hard
# ceiling. Percentage values track hosts with different physical memory sizes.
MemoryHigh=90%
MemoryMax=95%
MemorySwapMax=0
TasksMax=4096
