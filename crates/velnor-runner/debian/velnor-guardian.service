[Unit]
Description=Velnor node guardian (local supervision only)
Documentation=https://github.com/tailrocks/velnor
After=network-online.target
Wants=network-online.target
# No docker.service, no GitHub token, no job execution.

[Service]
Type=notify
WatchdogSec=30
TimeoutStartSec=0
Slice=velnor-control.slice
Environment=VELNOR_CAPABILITY_VALIDATION=strict
EnvironmentFile=/etc/velnor/velnor.env
# Intentionally omits secrets.env: the guardian must not hold a GitHub token.
ExecStartPre=/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnor-runner release verify-installed
ExecStart=/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnor-runner guardian --state-dir /var/lib/velnor
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
User=root
StateDirectory=velnor
RuntimeDirectory=velnor
LogsDirectory=velnor
WorkingDirectory=/var/lib/velnor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/velnor /run/velnor /var/log/velnor

[Install]
WantedBy=multi-user.target
