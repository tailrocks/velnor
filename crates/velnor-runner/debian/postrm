#!/bin/sh
set -e

PACKAGE_TRANSACTION_LOCK=/run/velnor/package-transaction.lock
WORKER_UNIT_GLOB=velnor-job@*.service
JOBS_SLICE_DROPIN_DIR=/etc/systemd/system/velnor-jobs.slice.d
JOBS_SLICE_DROPIN=$JOBS_SLICE_DROPIN_DIR/10-host-cpu.conf

fail() {
  echo "velnor-runner postrm: $1" >&2
  exit 1
}

require_package_transaction_lock() {
  # The deployment wrapper takes an exclusive lock on the path with --no-fork,
  # so dpkg and this maintainer script remain inside one package transaction.
  # Never stop or disable the fleet without proving that outer lock is held.
  lock_inode=$(stat -c '%i' "$PACKAGE_TRANSACTION_LOCK" 2>/dev/null || true)
  [ -n "$lock_inode" ] \
    || fail "cannot stat $PACKAGE_TRANSACTION_LOCK; aborting removal"
  lock_owner=$(awk -v inode="$lock_inode" '
    $2 == "FLOCK" {
      split($6, device_inode, ":")
      if (device_inode[3] == inode) {
        if ($4 != "WRITE") exit 2
        print $5
        exit
      }
    }' /proc/locks 2>/dev/null) || lock_owner=
  case "$lock_owner" in
    ''|*[!0-9]*) fail "no exclusive lock owner for $PACKAGE_TRANSACTION_LOCK; aborting removal" ;;
  esac
  current_pid=$$
  while [ "$current_pid" -gt 1 ]; do
    [ "$current_pid" = "$lock_owner" ] && return 0
    parent_pid=$(awk '$1 == "PPid:" { print $2; exit }' \
      "/proc/$current_pid/status" 2>/dev/null || true)
    case "$parent_pid" in
      ''|*[!0-9]*) break ;;
    esac
    [ "$parent_pid" = "$current_pid" ] && break
    current_pid=$parent_pid
  done
  fail "exclusive lock owner is not an apt-wrapper ancestor; aborting removal"
}

verify_worker_units_inactive() {
  worker_units=$(systemctl list-units --type=service --all --no-legend --plain \
    "$WORKER_UNIT_GLOB" 2>/dev/null) || return 1
  active_workers=$(printf '%s\n' "$worker_units" \
    | awk '$3 != "inactive" && $3 != "failed" {print $1 "(" $3 ")"}')
  [ -z "$active_workers" ]
}

verify_jobs_slice_inactive() {
  load_state=$(systemctl show --property=LoadState --value velnor-jobs.slice 2>/dev/null) \
    || return 1
  case "$load_state" in
    not-found)
      return 0
      ;;
    loaded)
      active_state=$(systemctl show --property=ActiveState --value velnor-jobs.slice 2>/dev/null) \
        || return 1
      if systemctl is-active --quiet velnor-jobs.slice; then
        return 1
      fi
      [ "$active_state" = inactive ]
      ;;
    *)
      return 1
      ;;
  esac
}

# The retired writer created an untracked file and shipped no sidecar
# provenance marker. Its exact four-line signature and CPUQuota formula are the
# only durable ownership evidence: byte-identical copies are the same retired
# policy and migrate too. Every other payload, symlink, or conflict fails closed.
# The packaged Debian targets are 64-bit: getconf returns sysconf's signed long,
# and /bin/sh arithmetic is signed intmax_t. The old positive-result guard and
# *95 formula cap valid output at floor(INT64_MAX/95)*95 = 9223372036854775790.
is_legacy_jobs_cpu_quota_dropin() {
  [ -f "$JOBS_SLICE_DROPIN" ] || return 1
  line_count=$(wc -l < "$JOBS_SLICE_DROPIN" 2>/dev/null) || return 1
  [ "$line_count" -eq 4 ] 2>/dev/null || return 1

  LC_ALL=C awk '
    function has_legacy_cpu_quota(line, quota, i, remainder) {
      if (line !~ /^CPUQuota=[1-9][0-9]*%$/) return 0
      quota = substr(line, 10, length(line) - 10)
      if (!decimal_at_most(quota, "9223372036854775790")) return 0
      remainder = 0
      for (i = 1; i <= length(quota); i++) {
        remainder = (remainder * 10 + substr(quota, i, 1)) % 95
      }
      return remainder == 0
    }

    function decimal_at_most(value, maximum, i, value_digit, maximum_digit) {
      if (length(value) < length(maximum)) return 1
      if (length(value) > length(maximum)) return 0
      for (i = 1; i <= length(value); i++) {
        value_digit = substr(value, i, 1) + 0
        maximum_digit = substr(maximum, i, 1) + 0
        if (value_digit < maximum_digit) return 1
        if (value_digit > maximum_digit) return 0
      }
      return 1
    }

    BEGIN { valid = 1 }
    NR == 1 { if ($0 != "[Slice]") { valid = 0; exit } next }
    NR == 2 { if ($0 != "# Generated from the host online CPU count during package configuration.") { valid = 0; exit } next }
    NR == 3 { if ($0 != "# CPUQuota is 95% of one CPU per online logical CPU.") { valid = 0; exit } next }
    NR == 4 { if (!has_legacy_cpu_quota($0)) { valid = 0; exit } next }
    NR > 4 { valid = 0; exit }
    END { if (NR != 4 || !valid) exit 1 }
  ' "$JOBS_SLICE_DROPIN"
}

remove_stale_jobs_cpu_quota_dropin() {
  if [ -L "$JOBS_SLICE_DROPIN_DIR" ]; then
    fail "refusing unknown conflict at $JOBS_SLICE_DROPIN_DIR: drop-in directory is a symlink"
  fi
  [ -e "$JOBS_SLICE_DROPIN_DIR" ] || return 0
  [ -d "$JOBS_SLICE_DROPIN_DIR" ] \
    || fail "refusing unknown conflict at $JOBS_SLICE_DROPIN_DIR: drop-in path is not a directory"

  if [ -L "$JOBS_SLICE_DROPIN" ]; then
    fail "refusing unknown conflict at $JOBS_SLICE_DROPIN: symlinks are not the legacy Velnor file"
  fi
  [ -e "$JOBS_SLICE_DROPIN" ] || return 0
  [ -f "$JOBS_SLICE_DROPIN" ] \
    || fail "refusing unknown conflict at $JOBS_SLICE_DROPIN: not a regular file"
  is_legacy_jobs_cpu_quota_dropin \
    || fail "refusing unknown conflict at $JOBS_SLICE_DROPIN: contents do not match the exact legacy Velnor CPU quota file"

  rm -f "$JOBS_SLICE_DROPIN" \
    || fail "could not remove stale Velnor CPU quota drop-in $JOBS_SLICE_DROPIN"
  echo "Removed stale Velnor CPU quota drop-in $JOBS_SLICE_DROPIN."
}

case "$1" in
  remove|purge)
    require_package_transaction_lock
    if [ -d /run/systemd/system ]; then
      all_units=$(systemctl list-unit-files --no-legend --plain \
        'velnor*.service' 'velnor*.timer' 2>/dev/null) \
        || fail "cannot enumerate Velnor units; aborting removal"

      # Runtime masks close the activation race for every enumerated Velnor
      # service and timer. They remain until systemd is reloaded and the
      # final worker and slice proofs pass.
      for unit in $(printf '%s\n' "$all_units" | awk '{print $1}'); do
        systemctl mask --runtime "$unit" \
          || fail "cannot mask $unit; aborting removal"
      done

      for unit in $(printf '%s\n' "$all_units" | awk '{print $1}'); do
        systemctl disable "$unit" \
          || fail "cannot disable $unit; aborting removal"
        systemctl reset-failed "$unit" \
          || fail "cannot reset $unit; aborting removal"
      done

      # With masks in place, disable first, then synchronously stop every
      # loaded Velnor service and timer instance. This closes the start-after-
      # check race before the final slice proof below.
      runtime_units=$(systemctl list-units --type=service --type=timer --all \
        --no-legend --plain 'velnor*.service' 'velnor*.timer' 2>/dev/null) \
        || fail "cannot enumerate loaded Velnor units; aborting removal"
      for unit in $(printf '%s\n' "$runtime_units" | awk '{print $1}'); do
        systemctl stop "$unit" \
          || fail "cannot stop $unit; aborting removal"
      done

      verify_worker_units_inactive \
        || fail "Velnor job worker is active or activating; aborting removal"

      # This is intentionally immediately after the stop loop: a stale
      # pre-stop check permits a job started in the gap to outlive removal.
      verify_jobs_slice_inactive \
        || fail "velnor-jobs.slice is not provably inactive; aborting removal"
    fi
    # Removal reaches this point only after loaded Velnor units and the jobs
    # slice are inactive. Clean the exact legacy file even when systemd is not
    # running, and leave every other drop-in in the operator's directory.
    remove_stale_jobs_cpu_quota_dropin
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || {
        echo "velnor-runner postrm: daemon-reload failed after package removal" >&2
        exit 1
      }

      # Keep runtime masks installed through maintainer-script exit. Removing
      # them here would reopen activation between the final proof and release
      # of the exclusive package lock. Runtime masks leave no persistent file
      # and disappear on reboot; a same-boot reinstall must explicitly unmask
      # the removed fleet before operator-controlled activation.
      verify_worker_units_inactive \
        || fail "Velnor job worker became active or activating after daemon-reload"
      verify_jobs_slice_inactive \
        || fail "velnor-jobs.slice is not provably inactive after daemon-reload"
    fi
    ;;
esac

exit 0
