#!/bin/sh
set -e

PACKAGE_TRANSACTION_LOCK=/run/velnor/package-transaction.lock
JOBS_SLICE_DROPIN_DIR=/etc/systemd/system/velnor-jobs.slice.d
JOBS_SLICE_DROPIN=$JOBS_SLICE_DROPIN_DIR/10-host-cpu.conf

fail() {
  echo "velnor-runner postrm: $1" >&2
  exit 1
}

require_package_transaction_lock() {
  # The deployment wrapper takes an exclusive lock on the path with --no-fork,
  # so dpkg and this maintainer script remain inside one package transaction.
  # Never stop or disable the fleet without proving that outer lock is held.
  lock_inode=$(stat -c '%i' "$PACKAGE_TRANSACTION_LOCK" 2>/dev/null || true)
  [ -n "$lock_inode" ] \
    || fail "cannot stat $PACKAGE_TRANSACTION_LOCK; aborting removal"
  lock_owner=$(awk -v inode="$lock_inode" '
    $2 == "FLOCK" {
      split($6, device_inode, ":")
      if (device_inode[3] == inode) {
        if ($4 != "WRITE") exit 2
        print $5
        exit
      }
    }' /proc/locks 2>/dev/null) || lock_owner=
  case "$lock_owner" in
    ''|*[!0-9]*) fail "no exclusive lock owner for $PACKAGE_TRANSACTION_LOCK; aborting removal" ;;
  esac
  current_pid=$$
  while [ "$current_pid" -gt 1 ]; do
    [ "$current_pid" = "$lock_owner" ] && return 0
    parent_pid=$(awk '$1 == "PPid:" { print $2; exit }' \
      "/proc/$current_pid/status" 2>/dev/null || true)
    case "$parent_pid" in
      ''|*[!0-9]*) break ;;
    esac
    [ "$parent_pid" = "$current_pid" ] && break
    current_pid=$parent_pid
  done
  fail "exclusive lock owner is not an apt-wrapper ancestor; aborting removal"
}

verify_jobs_slice_inactive() {
  load_state=$(systemctl show --property=LoadState --value velnor-jobs.slice 2>/dev/null) \
    || return 1
  case "$load_state" in
    not-found)
      return 0
      ;;
    loaded)
      active_state=$(systemctl show --property=ActiveState --value velnor-jobs.slice 2>/dev/null) \
        || return 1
      if systemctl is-active --quiet velnor-jobs.slice; then
        return 1
      fi
      [ "$active_state" = inactive ]
      ;;
    *)
      return 1
      ;;
  esac
}

remove_stale_jobs_cpu_quota_dropin() {
  # The package lock serializes cooperating package writes and /etc is
  # root-owned, so unprivileged users cannot replace this path during the
  # signature check and unlink. Independent privileged writers are outside
  # this transaction's guarantee.
  is_legacy_generated_jobs_cpu_quota_dropin() {
    # Historical packages recorded no owner metadata. Match the full output
    # language they generated; an operator edit within that language cannot be
    # distinguished from the original file by content alone.
    file="$1"
    [ ! -L "$file" ] && [ -f "$file" ] \
      || return 1
    [ "$(tail -c 1 "$file" | od -An -t x1 | tr -d '[:space:]')" = 0a ] \
      || return 1
    awk '
      function multiple_of_95(value, remainder, position, digit) {
        remainder = 0
        for (position = 1; position <= length(value); position++) {
          digit = substr(value, position, 1)
          remainder = (remainder * 10 + digit) % 95
        }
        return remainder == 0
      }
      BEGIN { valid = 1 }
      NR == 1 { if ($0 != "[Slice]") valid = 0; next }
      NR == 2 { if ($0 != "# Generated from the host online CPU count during package configuration.") valid = 0; next }
      NR == 3 { if ($0 != "# CPUQuota is 95% of one CPU per online logical CPU.") valid = 0; next }
      NR == 4 {
        quota = $0
        sub(/^CPUQuota=/, "", quota)
        sub(/%$/, "", quota)
        if ($0 !~ /^CPUQuota=[123456789][0123456789]*%$/ || !multiple_of_95(quota)) valid = 0
        next
      }
      { valid = 0 }
      END { if (NR != 4 || !valid) exit 1 }
    ' "$file"
  }

  # Older packages generated this exact host-scaled ceiling outside dpkg's
  # file list. Delete only that Velnor-owned file; preserve operator drop-ins.
  if [ -e "$JOBS_SLICE_DROPIN" ] || [ -L "$JOBS_SLICE_DROPIN" ]; then
    if is_legacy_generated_jobs_cpu_quota_dropin "$JOBS_SLICE_DROPIN"; then
      rm -- "$JOBS_SLICE_DROPIN"
      echo "Removed stale velnor-jobs.slice CPU quota drop-in $JOBS_SLICE_DROPIN."
    else
      echo "velnor-runner postrm: preserving unrecognized jobs-slice drop-in $JOBS_SLICE_DROPIN" >&2
    fi
  fi
  rmdir "$JOBS_SLICE_DROPIN_DIR" 2>/dev/null || true
}

case "$1" in
  remove|purge)
    require_package_transaction_lock
    if [ -d /run/systemd/system ]; then
      all_units=$(systemctl list-unit-files --no-legend --plain \
        'velnor*.service' 'velnor*.timer' 2>/dev/null) \
        || fail "cannot enumerate Velnor units; aborting removal"

      # Runtime masks close the activation race for every enumerated Velnor
      # service and timer. They remain through the final jobs-slice proof.
      for unit in $(printf '%s\n' "$all_units" | awk '{print $1}'); do
        systemctl mask --runtime "$unit" \
          || fail "cannot mask $unit; aborting removal"
      done

      for unit in $(printf '%s\n' "$all_units" | awk '{print $1}'); do
        systemctl disable "$unit" \
          || fail "cannot disable $unit; aborting removal"
        systemctl reset-failed "$unit" \
          || fail "cannot reset $unit; aborting removal"
      done

      # With masks in place, disable first, then synchronously stop every
      # loaded Velnor service and timer instance. This closes the start-after-
      # check race before the final slice proof below.
      runtime_units=$(systemctl list-units --type=service --type=timer --all \
        --no-legend --plain 'velnor*.service' 'velnor*.timer' 2>/dev/null) \
        || fail "cannot enumerate loaded Velnor units; aborting removal"
      for unit in $(printf '%s\n' "$runtime_units" | awk '{print $1}'); do
        systemctl stop "$unit" \
          || fail "cannot stop $unit; aborting removal"
      done

      # This is intentionally immediately after the stop loop: a stale
      # pre-stop check permits a job started in the gap to outlive removal.
      verify_jobs_slice_inactive \
        || fail "velnor-jobs.slice is not provably inactive; aborting removal"
      remove_stale_jobs_cpu_quota_dropin
      systemctl daemon-reload || {
        echo "velnor-runner postrm: daemon-reload failed after removing the stale job-slice quota drop-in" >&2
        exit 1
      }

      # Keep runtime masks installed through maintainer-script exit. Removing
      # them here would reopen activation between the final proof and release
      # of the exclusive package lock. Runtime masks leave no persistent file
      # and disappear on reboot; a same-boot reinstall must explicitly unmask
      # the removed fleet before operator-controlled activation.
      verify_jobs_slice_inactive \
        || fail "velnor-jobs.slice is not provably inactive after daemon-reload"
    fi
    ;;
esac

exit 0
