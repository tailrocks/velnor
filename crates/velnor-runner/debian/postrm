#!/bin/sh
set -e

JOBS_SLICE_DROPIN_DIR=/etc/systemd/system/velnor-jobs.slice.d
JOBS_SLICE_DROPIN=$JOBS_SLICE_DROPIN_DIR/10-host-cpu.conf

case "$1" in
  remove|purge)
    if [ -d /run/systemd/system ]; then
      load_state=$(systemctl show --property=LoadState --value velnor-jobs.slice 2>/dev/null) || {
        echo "velnor-runner postrm: cannot verify velnor-jobs.slice state; keeping CPU quota" >&2
        exit 1
      }
      case "$load_state" in
        not-found)
          ;;
        loaded)
          active_state=$(systemctl show --property=ActiveState --value velnor-jobs.slice 2>/dev/null) || {
            echo "velnor-runner postrm: cannot verify velnor-jobs.slice activity; keeping CPU quota" >&2
            exit 1
          }
          if systemctl is-active --quiet velnor-jobs.slice; then
            echo "velnor-runner postrm: refusing to remove the CPU quota while velnor-jobs.slice is active" >&2
            exit 1
          fi
          case "$active_state" in
            inactive)
              ;;
            *)
              echo "velnor-runner postrm: refusing to remove the CPU quota while velnor-jobs.slice is $active_state" >&2
              exit 1
              ;;
          esac
          ;;
        *)
          echo "velnor-runner postrm: unexpected velnor-jobs.slice load state '$load_state'; keeping CPU quota" >&2
          exit 1
          ;;
      esac
    fi
    if [ -d /run/systemd/system ]; then
      doctor_units=$(systemctl list-unit-files --no-legend --plain 'velnor-doctor*.timer' 'velnor-doctor*.service' 2>/dev/null) || {
        echo "velnor-runner postrm: cannot enumerate doctor units; keeping CPU quota" >&2
        exit 1
      }
      for unit in $(printf '%s\n' "$doctor_units" | awk '{print $1}'); do
        systemctl disable "$unit" || {
          echo "velnor-runner postrm: cannot disable $unit; keeping CPU quota" >&2
          exit 1
        }
        systemctl reset-failed "$unit" || {
          echo "velnor-runner postrm: cannot reset $unit; keeping CPU quota" >&2
          exit 1
        }
      done
      daemon_units=$(systemctl list-unit-files --no-legend --plain 'velnor-daemon.service' 'velnor-daemon@*.service' 2>/dev/null) || {
        echo "velnor-runner postrm: cannot enumerate daemon units; keeping CPU quota" >&2
        exit 1
      }
      for unit in $(printf '%s\n' "$daemon_units" | awk '{print $1}'); do
        systemctl disable "$unit" || {
          echo "velnor-runner postrm: cannot disable $unit; keeping CPU quota" >&2
          exit 1
        }
        systemctl reset-failed "$unit" || {
          echo "velnor-runner postrm: cannot reset $unit; keeping CPU quota" >&2
          exit 1
        }
      done
    fi
    rm -f "$JOBS_SLICE_DROPIN"
    rmdir "$JOBS_SLICE_DROPIN_DIR" 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || {
        echo "velnor-runner postrm: daemon-reload failed after removing the CPU quota" >&2
        exit 1
      }
    fi
    ;;
esac

exit 0
