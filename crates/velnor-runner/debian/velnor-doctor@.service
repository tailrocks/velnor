[Unit]
Description=Velnor fleet health probe (%i)
Documentation=https://github.com/tailrocks/velnor
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=VELNOR_STORAGE_ROOT=/var
EnvironmentFile=/etc/velnor/%i.env
EnvironmentFile=-/etc/velnor/%i.secrets.env
# Same StateDirectory as velnor-daemon@%i so STATE_DIRECTORY wins over
# VELNOR_STORAGE_ROOT. Doctor SLO samples and in-flight heal read
# /var/lib/velnor-%i/runner/daemons/<name>, not /var/lib/velnor/runner.
StateDirectory=velnor-%i
ExecStart=/usr/bin/velnorctl doctor \
  --url ${VELNOR_URL} \
  --name ${VELNOR_NAME} \
  --slots ${VELNOR_SLOTS}
