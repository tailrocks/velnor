#!/bin/sh
# Plan 010 — transactional host activation, post-unpack.
#
# This script NEVER builds an image and NEVER restarts a daemon. The old
# postinst rebuilt a mutable Dockerfile and `try-restart ... || true`, trusting a
# single mutable image label with no manifest/source/digest check and restarting
# before equality. That is replaced with: validate the installed binary against
# the shipped acyclic identity, and (if a release record is already staged) prove
# coherence against the package's own shipped identity. The active pointer is
# deliberately NOT checked here: during a drained upgrade it still names the
# exact rollback predecessor until the operator activates the new record.
# ExecStartPre fails closed on that temporary mismatch, so no daemon can start.
# Activation, image acquisition, and restart
# are a separate, explicit `velnorctl release activate` step run by the
# deployment flow, never here.
set -e

BIN=/usr/bin/velnor-runner
SHARE=/usr/share/velnor
RELEASE_DIR=/var/lib/velnor/release
ACTIVE_DIR=$RELEASE_DIR/active
PACKAGE_TRANSACTION_LOCK=/run/velnor/package-transaction.lock
JOBS_SLICE_DROPIN_DIR=/etc/systemd/system/velnor-jobs.slice.d
JOBS_SLICE_DROPIN=$JOBS_SLICE_DROPIN_DIR/10-host-cpu.conf

fail() {
  echo "velnor-runner postinst: $1" >&2
  exit 1
}

# Workload containers run unbounded: no quota drop-in is ever written. Older
# packages generated a host-scaled CPUQuota drop-in here; upgrades delete
# that stale ceiling instead of recreating it.
remove_stale_jobs_cpu_quota_dropin() {
  if [ -e "$JOBS_SLICE_DROPIN" ] || [ -L "$JOBS_SLICE_DROPIN" ]; then
    [ ! -L "$JOBS_SLICE_DROPIN" ] && [ -f "$JOBS_SLICE_DROPIN" ] \
      || fail "refusing unexpected stale jobs-slice drop-in type: $JOBS_SLICE_DROPIN"
    JOBS_SLICE_DROPIN_BACKUP="$JOBS_SLICE_DROPIN_DIR/.10-host-cpu.conf.velnor-backup-$$"
    if [ -e "$JOBS_SLICE_DROPIN_BACKUP" ] || [ -L "$JOBS_SLICE_DROPIN_BACKUP" ]; then
      fail "refusing existing jobs-slice drop-in backup: $JOBS_SLICE_DROPIN_BACKUP"
    fi
    JOBS_SLICE_DROPIN_IDENTITY=$(stat -c '%d:%i' "$JOBS_SLICE_DROPIN") \
      || fail "could not pin stale jobs-slice drop-in identity: $JOBS_SLICE_DROPIN"
    trap 'restore_stale_jobs_cpu_quota_dropin "$?"' 0
    mv "$JOBS_SLICE_DROPIN" "$JOBS_SLICE_DROPIN_BACKUP" \
      || fail "could not stage stale jobs-slice drop-in for reversible removal"
    [ ! -L "$JOBS_SLICE_DROPIN_BACKUP" ] && [ -f "$JOBS_SLICE_DROPIN_BACKUP" ] \
      || fail "staged jobs-slice drop-in is not the expected regular file"
    staged_identity=$(stat -c '%d:%i' "$JOBS_SLICE_DROPIN_BACKUP") \
      || fail "could not verify staged jobs-slice drop-in identity"
    [ "$staged_identity" = "$JOBS_SLICE_DROPIN_IDENTITY" ] \
      || fail "stale jobs-slice drop-in changed while it was staged"
  fi
}

restore_stale_jobs_cpu_quota_dropin() {
  status="$1"
  trap - 0
  backup=${JOBS_SLICE_DROPIN_BACKUP:-}
  if [ -n "$backup" ] && { [ -e "$backup" ] || [ -L "$backup" ]; }; then
    if [ "$status" -eq 0 ]; then
      if [ ! -L "$backup" ] && [ -f "$backup" ] \
        && [ "$(stat -c '%d:%i' "$backup" 2>/dev/null || true)" = "${JOBS_SLICE_DROPIN_IDENTITY:-}" ]; then
        rm -f "$backup" || status=1
      else
        echo "velnor-runner postinst: staged drop-in identity changed; preserving it" >&2
        status=1
      fi
    fi
    if [ "$status" -ne 0 ]; then
      if [ ! -e "$JOBS_SLICE_DROPIN" ] && [ ! -L "$JOBS_SLICE_DROPIN" ]; then
        mv "$backup" "$JOBS_SLICE_DROPIN" \
          || echo "velnor-runner postinst: failed to restore $JOBS_SLICE_DROPIN" >&2
        systemctl daemon-reload \
          || echo "velnor-runner postinst: failed to reload restored jobs-slice drop-in" >&2
      else
        echo "velnor-runner postinst: cannot restore stale jobs-slice drop-in over a new file" >&2
      fi
    fi
    if [ "$status" -eq 0 ]; then
      rmdir "$JOBS_SLICE_DROPIN_DIR" 2>/dev/null || true
      echo "Removed stale velnor-jobs.slice CPU quota drop-in $JOBS_SLICE_DROPIN."
    fi
  fi
  exit "$status"
}

verify_jobs_slice_has_no_resource_ceilings() {
  ceiling=$(systemctl show \
    --property=CPUQuotaPerSecUSec --property=MemoryHigh --property=MemoryMax \
    --property=MemorySwapMax --property=TasksMax \
    --value velnor-jobs.slice 2>/dev/null) \
    || fail "could not read effective velnor-jobs.slice resource properties after daemon-reload"
  # Validate each complete returned value and count all five properties. The
  # property order is deliberately ignored: supported systemd versions may
  # return --value fields in a different order.
  ceiling_count=$(printf '%s\n' "$ceiling" | awk '
    BEGIN { valid = 1 }
    {
      if (tolower($0) != "infinity") valid = 0
      count++
    }
    END {
      if (!valid || count != 5) exit 1
      print count
    }
  ') \
    || fail "velnor-jobs.slice resource properties are not exactly five infinity values after the quota drop-in removal: $ceiling"
  [ "$ceiling_count" -eq 5 ] \
    || fail "velnor-jobs.slice resource properties are not all infinity after the quota drop-in removal: $ceiling"
}

require_package_transaction_lock() {
  # The deployment wrapper takes an exclusive lock on the path with --no-fork,
  # so the apt process itself remains the kernel lock owner through dpkg and
  # every maintainer script. Never accept a caller-controlled marker or acquire
  # a new lock here: a shared lock or an unrelated process must fail closed.
  [ -f "$PACKAGE_TRANSACTION_LOCK" ] && [ ! -L "$PACKAGE_TRANSACTION_LOCK" ] \
    || fail "refusing package transaction: lock path is not a regular non-symlink file"
  exec 9<"$PACKAGE_TRANSACTION_LOCK" \
    || fail "refusing package transaction: cannot pin $PACKAGE_TRANSACTION_LOCK"
  lock_target=$(readlink "/proc/$$/fd/9" 2>/dev/null || true)
  [ "$lock_target" = "$PACKAGE_TRANSACTION_LOCK" ] \
    || fail "refusing package transaction: pinned lock descriptor has an unexpected path"
  lock_identity_decimal=$(stat -L -c '%Hd:%Ld:%i' "/proc/$$/fd/9" 2>/dev/null || true)
  [ -n "$lock_identity_decimal" ] \
    || fail "refusing package transaction: cannot identify pinned lock descriptor"
  lock_identity=$(printf '%s\n' "$lock_identity_decimal" | awk -F: '
    NR != 1 || NF != 3 || $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ {
      invalid = 1
      exit
    }
    {
      printf "%s:%s:%s\n", sprintf("%x", $1 + 0), sprintf("%x", $2 + 0), $3
    }
    END { if (invalid || NR != 1) exit 1 }
  ') || lock_identity=
  [ -n "$lock_identity" ] \
    || fail "refusing package transaction: cannot normalize pinned lock descriptor identity"
  lock_owner=$(awk -v identity="$lock_identity" '
    function normalized_hex(value) {
      value = tolower(value)
      sub(/^0+/, "", value)
      return value == "" ? "0" : value
    }
    BEGIN { split(identity, expected, ":") }
    $0 ~ /->/ { next }
    $2 == "FLOCK" {
      split($6, device_inode, ":")
      if (normalized_hex(device_inode[1]) == normalized_hex(expected[1]) \
          && normalized_hex(device_inode[2]) == normalized_hex(expected[2]) \
          && device_inode[3] == expected[3]) {
        if ($4 != "WRITE" || owner != "") exit 2
        owner = $5
      }
    }
    END { if (owner != "") print owner; else exit 2 }' /proc/locks 2>/dev/null) || lock_owner=
  [ -n "$lock_owner" ] || fail "refusing package transaction: no unique exclusive lock owner for $PACKAGE_TRANSACTION_LOCK"
  case "$lock_owner" in
    ''|*[!0-9]*) fail "refusing package transaction: no exclusive lock owner for $PACKAGE_TRANSACTION_LOCK" ;;
  esac
  current_pid=$$
  while [ "$current_pid" -gt 1 ]; do
    [ "$current_pid" = "$lock_owner" ] && return 0
    parent_pid=$(awk '$1 == "PPid:" { print $2; exit }' \
      "/proc/$current_pid/status" 2>/dev/null || true)
    case "$parent_pid" in
      ''|*[!0-9]*) break ;;
    esac
    [ "$parent_pid" = "$current_pid" ] && break
    current_pid=$parent_pid
  done
  fail "refusing package transaction: exclusive lock owner is not an apt-wrapper ancestor"
}

systemd_property() {
  systemctl show --property="$2" --value "$1" 2>/dev/null
}

systemd_activation_version_supported() {
  version_output=$(systemctl show --property=Version --value 2>/dev/null) || return 1
  # kdbus `.busname` units were removed in systemd v235; older managers are unsupported.
  printf '%s\n' "$version_output" | awk '
    NR == 1 {
      version = $1 == "systemd" ? $2 : $1
      if (version !~ /^[0-9]+([.][0-9]+)*$/) { invalid = 1; exit }
      split(version, parts, ".")
      if (parts[1] + 0 < 235) invalid = 1
    }
    END { if (invalid || NR == 0) exit 1 }
  '
}

systemd_property_matches() {
  queried_property_value=$(systemd_property "$1" "$2") || return 1
  [ "$queried_property_value" = "$3" ]
}

systemd_property_is_empty() {
  queried_property_value=$(systemd_property "$1" "$2") || return 1
  [ -z "$queried_property_value" ]
}

valid_systemd_instance_name() {
  case "$1" in ''|.|..) return 1 ;; *[!A-Za-z0-9._:-]*) return 1 ;; esac
  [ "${#1}" -le 233 ]
}

systemd_service_is_dbus_activatable() {
  service_type=$(systemd_property "$1" Type) || return 2
  bus_name=$(systemd_property "$1" BusName) || return 2
  [ "$service_type" = dbus ] || [ -n "$bus_name" ]
}

reload_system_bus_activation_cache() {
  busctl --system call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus ReloadConfig >/dev/null 2>&1
}

systemd_bus_manager_owner() {
  busctl --system call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus GetNameOwner s org.freedesktop.systemd1 2>/dev/null \
    | awk '
      NF != 2 || $1 != "s" { exit 1 }
      {
        owner = $2
        gsub(/^\"|\"$/, "", owner)
        if (owner !~ /^:[0-9]+[.][0-9]+$/) exit 1
        print owner
      }
    '
}

dbus_bus_config_file() {
  bus_state=$(systemd_property dbus.service ActiveState) || return 2
  [ "$bus_state" = active ] || return 2
  bus_reload=$(systemd_property dbus.service NeedDaemonReload) || return 2
  [ "$bus_reload" = no ] || return 2
  bus_exec_start=$(systemd_property dbus.service ExecStart) || return 2
  printf '%s\n' "$bus_exec_start" | awk '
    function fail() { invalid = 1; exit }
    {
      if (NR != 1 || index($0, "{ path=") != 1 || gsub(/\{ path=/, "&") != 1) fail()
      backslash = sprintf("%c", 92)
      single_quote = sprintf("%c", 39)
      double_quote = sprintf("%c", 34)
      if (index($0, backslash) || index($0, single_quote) || index($0, double_quote)) fail()
      argv_marker = " ; argv[]="
      argv_start = index($0, argv_marker)
      ignore_marker = " ; ignore_errors="
      ignore_start = index($0, ignore_marker)
      if (!argv_start || !ignore_start || ignore_start <= argv_start) fail()
      path = substr($0, 8, argv_start - 8)
      argv = substr($0, argv_start + length(argv_marker), ignore_start - (argv_start + length(argv_marker)))
      tail = substr($0, ignore_start + length(ignore_marker))
      split(tail, ending, " ; ")
      if (ending[1] != "no" || path == "" || argv == "") fail()
      argc = split(argv, args, /[[:space:]]+/)
      if (args[1] != path) fail()
      if (path != "/usr/bin/dbus-daemon") fail()
      config = ""
      system_bus = 0
      for (i = 2; i <= argc; i++) {
        if (args[i] == "--config-file") {
          if (config != "" || i == argc) fail()
          config = args[++i]
        } else if (args[i] ~ /^--config-file=/) {
          if (config != "") fail()
          config = args[i]
          sub(/^--config-file=/, "", config)
        } else if (args[i] == "--system") {
          system_bus = 1
        } else if (args[i] == "--session") {
          fail()
        } else if (args[i] == "--nofork" || args[i] == "--nopidfile" \
          || args[i] == "--systemd-activation" || args[i] == "--syslog" \
          || args[i] == "--syslog-only" || args[i] == "--address=systemd:") {
          # Expected system-bus daemon options.
        } else {
          fail()
        }
      }
      if (config == "" && !system_bus) fail()
      if (config == "") config = "/usr/share/dbus-1/system.conf"
      if (config !~ /^\// || config ~ /(^|\/)\.\.($|\/)/ || config ~ /[[:space:]:]/) fail()
      print config
    }
    END { if (invalid || NR != 1) exit 2 }
  '
}

dbus_config_directives() {
  awk '
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }
    function strip_comments(value, output, start, end) {
      output = ""
      while (1) {
        if (in_comment) {
          end = index(value, "-->")
          if (!end) return output
          value = substr(value, end + 3)
          in_comment = 0
        } else {
          start = index(value, "<!--")
          if (!start) return output value
          output = output substr(value, 1, start - 1)
          value = substr(value, start + 4)
          in_comment = 1
        }
      }
    }
    function has_unsupported_entity(value, cleaned) {
      cleaned = value
      gsub(/&(amp|lt|gt|apos|quot);/, "", cleaned)
      gsub(/&#[0-9]+;/, "", cleaned)
      gsub(/&#x[[:xdigit:]]+;/, "", cleaned)
      return index(cleaned, "&") != 0
    }
    function emit(kind, value, path) {
      value = trim(value)
      if (value == "" || value ~ /[[:space:]:]/ || value ~ /&/) { invalid = 1; exit }
      print kind "\t" value
    }
    function parse_include(open, body, attrs, fields, count, i, key, value, ignore, selinux_root, seen_ignore, seen_selinux, seen_root_relative) {
      attrs = substr(open, 9, length(open) - 9)
      attrs = trim(attrs)
      ignore = "no"
      selinux_root = "no"
      selinux_enabled_condition = "no"
      seen_ignore = 0
      seen_selinux = 0
      seen_root_relative = 0
      if (attrs != "") {
        count = split(attrs, fields, /[[:space:]]+/)
        for (i = 1; i <= count; i++) {
          if (split(fields[i], pair, "=") != 2) { invalid = 1; return }
          key = pair[1]
          value = pair[2]
          if (value !~ /^"(yes|no)"$/) { invalid = 1; return }
          value = substr(value, 2, length(value) - 2)
          if (key == "ignore_missing" && !seen_ignore++) ignore = value
          else if (key == "if_selinux_enabled" && !seen_selinux++) {
            if (value != "yes" && value != "no") invalid = 1
            selinux_enabled_condition = value
          }
          else if (key == "selinux_root_relative" && !seen_root_relative++) selinux_root = value
          else { invalid = 1; return }
        }
      }
      if (invalid) return
      if (selinux_root == "yes") emit("selinux-include:" ignore ":" selinux_enabled_condition, body)
      else emit("include:" ignore ":" selinux_enabled_condition, body)
    }
    {
      line = strip_comments($0)
      if (has_unsupported_entity(line)) { invalid = 1; exit }
      if (line == "") next
      while (match(line, /<standard_system_servicedirs[[:space:]]*\/>/)) {
        print "standard\t"
        line = substr(line, RSTART + RLENGTH)
      }
      while (index(line, "<servicedir") || index(line, "<includedir")) {
        if (match(line, /<servicedir>[[:space:]]*[^<]*[[:space:]]*<\/servicedir>/)) {
          matched_start = RSTART
          matched_length = RLENGTH
          token = substr(line, matched_start, matched_length)
          value = token
          sub(/^<servicedir>/, "", value)
          sub(/<\/servicedir>$/, "", value)
          emit("servicedir", value)
        } else if (match(line, /<includedir>[[:space:]]*[^<]*[[:space:]]*<\/includedir>/)) {
          matched_start = RSTART
          matched_length = RLENGTH
          token = substr(line, matched_start, matched_length)
          value = token
          sub(/^<includedir>/, "", value)
          sub(/<\/includedir>$/, "", value)
          emit("includedir", value)
        } else { invalid = 1; exit }
        line = substr(line, 1, matched_start - 1) substr(line, matched_start + matched_length)
      }
      while (index(line, "<include")) {
        open_start = index(line, "<include")
        open_end = index(substr(line, open_start), ">")
        if (!open_end) { invalid = 1; exit }
        open_end += open_start - 1
        open = substr(line, open_start, open_end - open_start + 1)
        close_start = index(substr(line, open_end + 1), "</include>")
        if (!close_start || open ~ /\/>$/) { invalid = 1; exit }
        close_start += open_end
        body = substr(line, open_end + 1, close_start - open_end - 1)
        parse_include(open, body)
        if (invalid) exit
        line = substr(line, 1, open_start - 1) substr(line, close_start + 10)
      }
      if (index(line, "<servicedir") || index(line, "<includedir") || index(line, "<standard_system_servicedirs") || index(line, "<include")) { invalid = 1; exit }
    }
    END { if (invalid || in_comment) exit 2 }
  ' "$1"
}

dbus_selinux_enabled() {
  selinux_root=/sys/fs/selinux
  enforce_file=$selinux_root/enforce
  if [ -f "$enforce_file" ] && [ ! -L "$enforce_file" ]; then
    enforce_value=$(cat "$enforce_file" 2>/dev/null) || return 2
    case "$enforce_value" in 0|1) return 0 ;; *) return 2 ;; esac
  fi
  if [ ! -e "$selinux_root" ] && [ ! -L "$selinux_root" ]; then return 1; fi
  return 2
}

dbus_walk_config() (
  config_file=$1
  seen_configs=$2
  depth=$3
  [ "$depth" -lt 64 ] || return 2
  canonical_config=$(readlink -f "$config_file" 2>/dev/null) || return 2
  case ":$seen_configs:" in *":$canonical_config:"*) return 2 ;; esac
  seen_configs="$seen_configs:$canonical_config"
  config_parent=${canonical_config%/*}
  directives=$(dbus_config_directives "$canonical_config") || return 2
  while IFS="$(printf '\t')" read -r directive path; do
    case "$directive" in
      standard)
        printf '%s\n' /etc/dbus-1/system-services /run/dbus-1/system-services \
          /usr/local/share/dbus-1/system-services /usr/share/dbus-1/system-services \
          /lib/dbus-1/system-services
        ;;
      servicedir)
        case "$path" in /*) ;; *) return 2 ;; esac
        [ -d "$path" ] || return 2
        canonical_service_dir=$(readlink -f "$path" 2>/dev/null) || return 2
        printf '%s\n' "$canonical_service_dir"
        ;;
      includedir)
        case "$path" in /*) include_dir=$path ;; *) include_dir=$config_parent/$path ;; esac
        [ -d "$include_dir" ] || return 2
        canonical_include_dir=$(readlink -f "$include_dir" 2>/dev/null) || return 2
        for included_file in "$canonical_include_dir"/*.conf; do
          [ -e "$included_file" ] || [ -L "$included_file" ] || continue
          [ -f "$included_file" ] || return 2
          nested_dirs=$(dbus_walk_config "$included_file" "$seen_configs" "$((depth + 1))") || return 2
          [ -z "$nested_dirs" ] || printf '%s\n' "$nested_dirs"
        done
        ;;
      include:*|selinux-include:*)
        include_kind=${directive%%:*}
        include_options=${directive#*:}
        optional=${include_options%%:*}
        selinux_condition=${include_options#*:}
        # The package scan has no trusted mapping from the host SELinux root
        # into a staged policy root. Refuse root-relative includes before
        # evaluating if_selinux_enabled; skipping them could hide activation
        # services from the purge drain proof.
        [ "$include_kind" = selinux-include ] && return 2
        if [ "$selinux_condition" = yes ]; then
          if dbus_selinux_enabled; then
            :
          else
            selinux_status=$?
            [ "$selinux_status" -eq 1 ] && continue
            return 2
          fi
        fi
        case "$path" in /*) include_file=$path ;; *) include_file=$config_parent/$path ;; esac
        if [ ! -e "$include_file" ] && [ ! -L "$include_file" ]; then
          [ "$optional" = yes ] || return 2
          continue
        fi
        [ -f "$include_file" ] || return 2
        nested_dirs=$(dbus_walk_config "$include_file" "$seen_configs" "$((depth + 1))") || return 2
        [ -z "$nested_dirs" ] || printf '%s\n' "$nested_dirs"
        ;;
      '') ;;
      *) return 2 ;;
    esac
  done <<EOF
$directives
EOF
)

dbus_effective_service_dirs() {
  config_file=$(dbus_bus_config_file) || return 2
  service_dirs=$(dbus_walk_config "$config_file" "" 0) || return 2
  printf '%s\n' "$service_dirs" | sort -u
}

dbus_activation_file_properties() {
  awk '
    function valid_systemd_service(value, base, ats) {
      if (value !~ /^[A-Za-z0-9_.@:-]+[.]service$/ || length(value) > 255) return 0
      base = value
      sub(/[.]service$/, "", base)
      if (base == "" || base ~ /^[.]/ || base ~ /\.\./) return 0
      ats = gsub(/@/, "@", base)
      return ats <= 1
    }
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }
    /^[[:space:]]*[#;]/ { next }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /\\$/) { invalid = 1; exit }
      if (line ~ /^[[:space:]]*\[/) {
        if (line !~ /\][[:space:]]*$/) { invalid = 1; exit }
        section = trim(line)
        in_service = section == "[D-BUS Service]"
        next
      }
      if (!in_service) next
      separator = index(line, "=")
      if (!separator) { invalid = 1; exit }
      key = trim(substr(line, 1, separator - 1))
      value = trim(substr(line, separator + 1))
      if (key == "SystemdService") {
        if (seen_systemd || !valid_systemd_service(value)) { invalid = 1; exit }
        seen_systemd = 1
        print key "\t" value
      } else if (key == "Exec") {
        single_quote = sprintf("%c", 39)
        double_quote = sprintf("%c", 34)
        backslash = sprintf("%c", 92)
        if (seen_exec || value == "" || index(value, single_quote) || index(value, double_quote) || index(value, backslash) || index(value, ";")) { invalid = 1; exit }
        seen_exec = 1
        print key "\t" value
      }
    }
    END { if (invalid || (!seen_exec && !seen_systemd)) exit 2 }
  ' "$1"
}

dbus_activation_service_files_safe() {
  service_dirs=$(dbus_effective_service_dirs) || return 2
  while IFS= read -r activation_dir; do
    [ -n "$activation_dir" ] || continue
    [ -e "$activation_dir" ] || [ -L "$activation_dir" ] || continue
    [ -d "$activation_dir" ] && [ -r "$activation_dir" ] || return 2
    for activation_file in "$activation_dir"/*.service; do
      [ -e "$activation_file" ] || [ -L "$activation_file" ] || continue
      [ -f "$activation_file" ] || return 2
      activation_properties=$(dbus_activation_file_properties "$activation_file") || return 2
      while IFS="$(printf '\t')" read -r activation_key activation_value; do
        case "$activation_key" in
          SystemdService)
            if service_invokes_packaged_runner "$activation_value"; then
              return 1
            else
              activation_query_status=$?
              [ "$activation_query_status" -eq 2 ] || return 2
            fi
            ;;
          Exec)
            activation_executable=${activation_value%% *}
            if command_properties_invoke_velnor "{ path=$activation_executable ; argv[]=$activation_value ; }"; then
              return 1
            fi
            ;;
        esac
      done <<EOF
$activation_properties
EOF
    done
  done <<EOF
$service_dirs
EOF
  return 0
}

append_active_unit() {
  if [ -n "$active_units" ]; then
    active_units="$active_units $1"
  else
    active_units=$1
  fi
}

exact_maintenance_exec_start() {
  expected_argv="$1"
  property="$2"
  printf '%s\n' "$property" | awk -v expected="$expected_argv" '
    NR != 1 { exit 1 }
    {
      records = gsub(/\{ path=/, "&")
      prefix = "{ path=/usr/bin/flock ; argv[]=" expected " ; ignore_errors=no ; start_time="
      if (records != 1 || index($0, prefix) != 1) exit 1
      tail = substr($0, length(prefix) + 1)
      if (tail !~ /^\[[^]]*\] ; stop_time=\[[^]]*\] ; pid=[0-9]+ ; code=\([^)]*\) ; status=[^[:space:]]+ }$/) exit 1
    }
    END { if (NR != 1) exit 1 }
  '
}

exact_locked_shell_exec_start() {
  property="$1"
  printf '%s\n' "$property" | awk -v lock="$PACKAGE_TRANSACTION_LOCK" '
    NR != 1 { exit 1 }
    {
      records = gsub(/\{ path=/, "&")
      prefix = "{ path=/usr/bin/flock ; argv[]=/usr/bin/flock --shared --no-fork " lock " /bin/sh -c "
      if (records != 1 || index($0, prefix) != 1) exit 1
      tail = substr($0, length(prefix) + 1)
      if (tail !~ /^.+ ; ignore_errors=no ; start_time=\[[^]]*\] ; stop_time=\[[^]]*\] ; pid=[0-9]+ ; code=\([^)]*\) ; status=[^[:space:]]+ }$/) exit 1
    }
    END { if (NR != 1) exit 1 }
  '
}

maintenance_service_under_transaction_lock() {
  case "$1" in
    velnor-cache-gc.service)
      expected_argv='/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnorctl cache gc --yes'
      expected_fragment=velnor-cache-gc.service
      expected_fragment_sha=ad79a2d4b611b79b96c62fba8d0ef4faf7c5756b6105dea181aeeef4d19af060
      fleet_audit=0
      ;;
    velnor-doctor.service)
      expected_argv='/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnorctl doctor --url ${VELNOR_URL} --name ${VELNOR_NAME} --slots ${VELNOR_SLOTS}'
      expected_fragment=velnor-doctor.service
      expected_fragment_sha=54497b95693b59b9afcd820551d7caa320ae3fbfa8a2c2d76639c828f61498e4
      fleet_audit=0
      ;;
    velnor-doctor@*.service)
      instance=${1#velnor-doctor@}
      instance=${instance%.service}
      valid_systemd_instance_name "$instance" || return 1
      expected_argv='/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnorctl doctor --url ${VELNOR_URL} --name ${VELNOR_NAME} --slots ${VELNOR_SLOTS}'
      expected_fragment=velnor-doctor@.service
      expected_fragment_sha=0df90fe8ef64187cb4e9aa9cb25da19f2f10f6d4438b1945b487a9a93dd3a831
      fleet_audit=0
      ;;
    velnor-fleet-policy-audit.service)
      expected_fragment=velnor-fleet-policy-audit.service
      expected_fragment_sha=09252a8f67de6dec269c2aaf50fe1e0a750942d55fbbd3bf1c60adfa482981c1
      fleet_audit=1
      ;;
    *)
      return 1
      ;;
  esac

  systemd_property_matches "$1" Type oneshot || return 1
  systemd_property_matches "$1" NeedDaemonReload no || return 1
  systemd_property_is_empty "$1" DropInPaths || return 1
  for property in ExecCondition ExecStartPre ExecStartPost ExecReload ExecStop ExecStopPost; do
    systemd_property_is_empty "$1" "$property" || return 1
  done

  fragment=$(systemd_property "$1" FragmentPath) || return 1
  case "$fragment" in
    "/usr/lib/systemd/system/$expected_fragment"|"/lib/systemd/system/$expected_fragment") ;;
    *) return 1 ;;
  esac
  exec_start=$(systemd_property "$1" ExecStart) || return 1
  fragment_sha=$(sha256sum "$fragment" 2>/dev/null | awk '{print $1}') || return 1
  [ "$fragment_sha" = "$expected_fragment_sha" ] || return 1
  if [ "$fleet_audit" -eq 1 ]; then
    exact_locked_shell_exec_start "$exec_start"
  else
    exact_maintenance_exec_start "$expected_argv" "$exec_start"
  fi
}

maintenance_timer_under_transaction_lock() {
  case "$1" in
    velnor-cache-gc.timer)
      expected_service=velnor-cache-gc.service
      expected_fragment=velnor-cache-gc.timer
      expected_fragment_sha=07b39f9d1e8ffcaa36e294ebec2328b10ad0d8b4f9779aa4ffb427a4af667cca
      ;;
    velnor-doctor.timer)
      expected_service=velnor-doctor.service
      expected_fragment=velnor-doctor.timer
      expected_fragment_sha=e5875dc62c7dd165c939890d38bc7112fba3765f13ef0324c457cb71043bafc3
      ;;
    velnor-doctor@*.timer)
      instance=${1#velnor-doctor@}
      instance=${instance%.timer}
      valid_systemd_instance_name "$instance" || return 1
      expected_service="velnor-doctor@$instance.service"
      expected_fragment=velnor-doctor@.timer
      expected_fragment_sha=1a5fc6f3b410b18fc2af230e6e86366d4e964d26e6ced22beb32aa4dad45bb0f
      ;;
    velnor-fleet-policy-audit.timer)
      expected_service=velnor-fleet-policy-audit.service
      expected_fragment=velnor-fleet-policy-audit.timer
      expected_fragment_sha=6560ebfd20be889f6a1a3d1a474582d1ea8a7438be287073cf619a36b3481889
      ;;
    *)
      return 1
      ;;
  esac

  systemd_property_matches "$1" NeedDaemonReload no || return 1
  systemd_property_is_empty "$1" DropInPaths || return 1
  fragment=$(systemd_property "$1" FragmentPath) || return 1
  case "$fragment" in
    "/usr/lib/systemd/system/$expected_fragment"|"/lib/systemd/system/$expected_fragment") ;;
    *) return 1 ;;
  esac
  fragment_sha=$(sha256sum "$fragment" 2>/dev/null | awk '{print $1}') || return 1
  [ "$fragment_sha" = "$expected_fragment_sha" ] || return 1
  systemd_property_matches "$1" Triggers "$expected_service" || return 1
  maintenance_service_under_transaction_lock "$expected_service"
}

scheduled_oneshot_under_transaction_lock() {
  case "$1" in
    *.service) maintenance_service_under_transaction_lock "$1" ;;
    *.timer) maintenance_timer_under_transaction_lock "$1" ;;
    *) return 1 ;;
  esac
}

command_properties_invoke_velnor() {
  commands="$1"
  case "$commands" in *velnor-runner*|*velnorctl*) return 0 ;; esac
  printf '%s\n' "$commands" | awk '
    {
      count = split($0, tokens, /[[:space:]]+/)
      in_argv = 0
      for (i = 1; i <= count; i++) {
        if (tokens[i] ~ /^argv\[\]=/) {
          in_argv = 1
          continue
        }
        if (in_argv) {
          argument = tokens[i]
          sub(/;$/, "", argument)
          if (argument ~ /^(daemon|controller|slot|job|guardian)$/) found = 1
          if (tokens[i] ~ /;$/) in_argv = 0
        }
      }
    }
    END { exit(found ? 0 : 1) }
  ' && return 0
  scripts=$(printf '%s\n' "$commands" | awk '
    {
      count = split($0, groups, /argv\[\]=/)
      for (group_index = 2; group_index <= count; group_index++) {
        group = groups[group_index]
        sub(/ ; .*/, "", group)
        argument_count = split(group, arguments, /[[:space:]]+/)
        command_index = 1
        executable = arguments[command_index]
        sub(/^[{(]+/, "", executable)
        sub(/[;}]+$/, "", executable)
        path_count = split(executable, path_parts, "/")
        basename = path_parts[path_count]
        env_unsafe = 0
        while (basename == "env") {
          command_index++
          while (command_index <= argument_count) {
            env_argument = arguments[command_index]
            if (env_argument == "--") { command_index++; break }
            if (env_argument == "-S" || env_argument == "--split-string" \
              || env_argument ~ /^-S./ || env_argument ~ /^--split-string=/) {
              env_unsafe = 1
              break
            }
            if (env_argument == "-u" || env_argument == "--unset" \
              || env_argument == "-C" || env_argument == "--chdir") {
              command_index += 2
              continue
            }
            if (env_argument ~ /^--unset=/ || env_argument ~ /^--chdir=/) {
              command_index++
              continue
            }
            if (env_argument ~ /^-/) {
              if (env_argument == "-i" || env_argument == "--ignore-environment" \
                || env_argument == "-0" || env_argument == "--null" \
                || env_argument == "-v" || env_argument == "--debug") {
                command_index++
                continue
              }
              env_unsafe = 1
              break
            }
            if (index(env_argument, "=") && env_argument !~ /^=/) {
              command_index++
              continue
            }
            break
          }
          if (env_unsafe || command_index > argument_count) {
            env_unsafe = 1
            break
          }
          executable = arguments[command_index]
          sub(/^[{(]+/, "", executable)
          sub(/[;}]+$/, "", executable)
          path_count = split(executable, path_parts, "/")
          basename = path_parts[path_count]
        }
        if (env_unsafe) {
          print "unsafe-inline"
          next
        }
        interpreter = basename ~ /^(sh|bash|dash|zsh|ksh|fish|env|perl|ruby|node|php|python|python2|python3)$/ \
          || basename ~ /^python([0-9]+([.][0-9]+)*[a-z]?)?$/
        inline_program = 0
        inline_program_unsafe = 0
        if (interpreter) {
          for (argument_index = command_index + 1; argument_index <= argument_count; argument_index++) {
            is_python = basename ~ /^python([0-9]+([.][0-9]+)*[a-z]?)?$/
            is_shell = basename == "sh" || basename == "bash" || basename == "dash" || basename == "zsh" || basename == "ksh" || basename == "fish"
            if ((is_python && arguments[argument_index] ~ /^-c/) \
              || (is_shell && arguments[argument_index] ~ /^-[[:alpha:]]*c/) \
              || ((basename == "perl" || basename == "ruby" || basename == "node") && arguments[argument_index] ~ /^-e/) \
              || (basename == "php" && arguments[argument_index] ~ /^-r/) \
              || (basename == "node" && arguments[argument_index] ~ /^--eval(=|$)/)) {
              inline_program = 1
              if (!(is_python && arguments[argument_index] == "-c" \
                && argument_count == argument_index + 1 \
                && arguments[argument_index + 1] == "pass")) inline_program_unsafe = 1
            }
          }
        }
        if (inline_program_unsafe) {
          print "unsafe-inline"
        } else if (interpreter && !inline_program) {
          for (argument_index = command_index + 1; argument_index <= argument_count; argument_index++) {
            if (arguments[argument_index] !~ /^-/) {
              script = arguments[argument_index]
              sub(/[;}]+$/, "", script)
              if (script != "") print "script:" script
              break
            }
          }
        } else if (!interpreter) {
          print "exec:" executable
        }
      }
    }
  ')
  script_parse_status=$?
  [ "$script_parse_status" -eq 0 ] || return 0
  [ -n "$scripts" ] || return 1
  while IFS= read -r wrapper_candidate; do
    [ -n "$wrapper_candidate" ] || continue
    case "$wrapper_candidate" in
      unsafe-inline) return 0 ;;
      script:*) wrapper_script=${wrapper_candidate#script:}; candidate_kind=script ;;
      exec:*) wrapper_script=${wrapper_candidate#exec:}; candidate_kind=exec ;;
      *) return 0 ;;
    esac
    case "$wrapper_script" in /*) ;; *) return 0 ;; esac
    case "$candidate_kind:$wrapper_script" in
      script:*|exec:*.sh|exec:*.bash|exec:*.py|exec:*.pl|exec:*.rb|exec:*.js) ;;
      *)
        [ -f "$wrapper_script" ] && [ -r "$wrapper_script" ] || return 0
        wrapper_header=$(od -An -N 2 -tx1 "$wrapper_script" 2>/dev/null) || return 0
        wrapper_header=$(printf '%s' "$wrapper_header" | tr -d '[:space:]')
        [ "$wrapper_header" = 2321 ] || continue
        ;;
    esac
    [ -f "$wrapper_script" ] && [ -r "$wrapper_script" ] || return 0
    wrapper_size=$(wc -c < "$wrapper_script" 2>/dev/null | tr -d '[:space:]') || return 0
    [ "$wrapper_size" -le 1048576 ] || return 0
    if grep -Eq 'velnor-runner|velnorctl|(^|[^[:alnum:]_])(daemon|controller|slot|job|guardian)([^[:alnum:]_]|$)' "$wrapper_script"; then
      return 0
    else
      grep_status=$?
      [ "$grep_status" -eq 1 ] || return 0
    fi
  done <<EOF
$scripts
EOF
  return 1
}

service_invokes_packaged_runner() {
  commands=$(systemctl show --no-pager \
    --property=ExecCondition --property=ExecStartPre --property=ExecStart \
    --property=ExecStartPost --property=ExecReload --property=ExecStop \
    --property=ExecStopPost --value "$1" 2>/dev/null) || return 1
  if command_properties_invoke_velnor "$commands"; then return 0; fi
  return 2
}

verify_pending_systemd_activation_jobs() {
  job_barrier=$(busctl --system call org.freedesktop.systemd1 \
    /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager ListJobs 2>/dev/null) || return 1
  printf '%s\n' "$job_barrier" | awk '
    NR != 1 || NF < 2 || $1 != "a(usssoo)" || $2 !~ /^[0-9]+$/ \
      || NF != 2 + ($2 * 6) { invalid = 1 }
    END { if (invalid || NR != 1) exit 1 }
  ' || return 1

  systemd_owner_after=$(systemd_bus_manager_owner) || return 1
  [ "$systemd_owner_after" = "$systemd_owner_before" ] || return 1

  jobs_raw=$(systemctl list-jobs --no-legend --no-pager --full 2>/dev/null) || return 1
  pending_activation_jobs=$(printf '%s\n' "$jobs_raw" | awk '
    NF == 0 { next }
    $0 == "No jobs running." && !saw_row { saw_empty = 1; next }
    saw_empty || NF != 4 || $1 !~ /^[0-9]+$/ || $2 == "" \
      || $3 !~ /^[[:alnum:]_-]+$/ \
      || $4 !~ /^(waiting|running|done|canceled|failed|dependency|skipped)$/ {
      invalid = 1
      next
    }
    {
      saw_row = 1
      if ($4 == "waiting" || $4 == "running") {
        if ($2 ~ /[.]service$/ || $2 ~ /[.](socket|path|timer)$/) print $2 "|" $4
      }
    }
    END { if (invalid) exit 1 }
  ') || {
    active_units=unknown
    return 1
  }

  for candidate in $pending_activation_jobs; do
    unit=${candidate%|*}
    state=${candidate##*|}
    case "$unit" in
      *.socket|*.path|*.timer)
        append_active_unit "pending-activation-job($unit:$state)"
        return 1
        ;;
      velnor*.service)
        if scheduled_oneshot_under_transaction_lock "$unit"; then
          continue
        fi
        append_active_unit "pending-service-job($unit:$state)"
        return 1
        ;;
      *.service)
        if service_invokes_packaged_runner "$unit"; then
          append_active_unit "pending-service-job($unit:$state)"
          return 1
        else
          query_status=$?
          [ "$query_status" -eq 2 ] || {
            active_units=unknown
            return 1
          }
        fi
        ;;
    esac
  done
  return 0
}

process_argv_invokes_velnor() {
  cmdline_path="$1"
  tr '\000' '\n' < "$cmdline_path" | awk '
    NR > 1 && $0 ~ /(^|[^[:alnum:]_])(daemon|controller|slot|job|guardian)([^[:alnum:]_]|$)/ { found = 1 }
    END { exit(found ? 0 : 1) }
  '
}

no_live_packaged_runner_process() {
  packaged_runner_identity=$(stat -L -c '%d:%i' /usr/bin/velnor-runner 2>/dev/null || true)
  packaged_runner_size=$(stat -L -c '%s' /usr/bin/velnor-runner 2>/dev/null || true)
  packaged_runner_sha=$(sha256sum /usr/bin/velnor-runner 2>/dev/null | awk '{print $1}' || true)
  if [ -e /usr/bin/velnor-runner ]; then
    [ -n "$packaged_runner_identity" ] && [ -n "$packaged_runner_size" ] \
      && [ -n "$packaged_runner_sha" ] || return 1
  fi
  for executable_link in /proc/[0-9]*/exe; do
    [ -L "$executable_link" ] || continue
    [ "$executable_link" != "/proc/$$/exe" ] || continue
    executable=$(readlink -- "$executable_link" 2>/dev/null) || {
      process_dir=$(dirname "$executable_link")
      [ ! -d "$process_dir" ] && continue
      return 1
    }
    executable_name=$(basename -- "$executable")
    case "$executable_name" in
      velnor-runner|"velnor-runner (deleted)") return 1 ;;
    esac
    process_dir=$(dirname "$executable_link")
    cmdline_path="$process_dir/cmdline"
    if [ -r "$cmdline_path" ]; then
      if process_argv_invokes_velnor "$cmdline_path" 2>/dev/null; then
        return 1
      else
        argv_status=$?
        [ "$argv_status" -eq 1 ] || {
          [ ! -d "$process_dir" ] && continue
          return 1
        }
      fi
    elif [ -d "$process_dir" ]; then
      return 1
    fi
    if [ -n "$packaged_runner_identity" ]; then
      process_identity=$(stat -L -c '%d:%i' "$executable_link" 2>/dev/null || true)
      if [ -z "$process_identity" ]; then
        process_dir=$(dirname "$executable_link")
        [ ! -d "$process_dir" ] && continue
        return 1
      fi
      [ "$process_identity" != "$packaged_runner_identity" ] || return 1
      if [ -n "$packaged_runner_size" ] && [ -n "$packaged_runner_sha" ]; then
        process_size=$(stat -L -c '%s' "$executable_link" 2>/dev/null || true)
        if [ "$process_size" = "$packaged_runner_size" ]; then
          process_sha=$(sha256sum "$executable_link" 2>/dev/null | awk '{print $1}' || true)
          [ -n "$process_sha" ] || {
            [ ! -d "$process_dir" ] && continue
            return 1
          }
          [ "$process_sha" != "$packaged_runner_sha" ] || return 1
        fi
      fi
    fi
  done
  return 0
}


all_velnor_units_drained() {
  if ! systemd_activation_version_supported; then
    active_units=unknown
    return 1
  fi
  if ! dbus_bus_config_file >/dev/null; then
    active_units=unknown
    return 1
  fi
  systemd_owner_before=$(systemd_bus_manager_owner) || {
    active_units=unknown
    return 1
  }
  if ! reload_system_bus_activation_cache; then
    active_units=unknown
    return 1
  fi

  services_raw=$(systemctl list-units --all --type=service --no-legend --no-pager --plain --full 2>/dev/null) || {
    active_units=unknown
    return 1
  }
  service_unit_files_raw=$(systemctl list-unit-files --type=service --no-legend --no-pager --full 2>/dev/null) || {
    active_units=unknown
    return 1
  }
  timers_raw=$(systemctl list-units --all --type=timer --no-legend --no-pager --plain --full 2>/dev/null) || {
    active_units=unknown
    return 1
  }
  active_services=$(printf '%s\n' "$services_raw" | awk '
    NF == 0 { next }
    NF < 4 || $1 !~ /\.service$/ || $2 == "" || $4 == "" \
      || $3 !~ /^(active|reloading|inactive|failed|activating|deactivating|maintenance)$/ {
      malformed = 1
      next
    }
    $3 != "inactive" && $3 != "failed" { print $1 "|" $3 }
    END { if (malformed) exit 1 }
  ') || {
    active_units=unknown
    return 1
  }
  service_unit_files=$(printf '%s\n' "$service_unit_files_raw" | awk '
    NF == 0 { next }
    NF < 2 || $1 !~ /\.service$/ || $2 == "" { malformed = 1; next }
    { print $1 }
    END { if (malformed) exit 1 }
  ') || {
    active_units=unknown
    return 1
  }
  active_timers=$(printf '%s\n' "$timers_raw" | awk '
    NF == 0 { next }
    NF < 4 || $1 !~ /\.timer$/ || $2 == "" || $4 == "" \
      || $3 !~ /^(active|reloading|inactive|failed|activating|deactivating|maintenance)$/ {
      malformed = 1
      next
    }
    $3 != "inactive" && $3 != "failed" { print $1 "|" $3 }
    END { if (malformed) exit 1 }
  ') || {
    active_units=unknown
    return 1
  }

  active_units=
  for candidate in $active_services; do
    unit=${candidate%|*}
    state=${candidate##*|}
    case "$unit" in
      velnor*)
        if scheduled_oneshot_under_transaction_lock "$unit"; then
          continue
        fi
        append_active_unit "$unit($state)"
        ;;
      *)
        if service_invokes_packaged_runner "$unit"; then
          append_active_unit "$unit($state)"
        else
          query_status=$?
          [ "$query_status" -eq 2 ] || {
            active_units=unknown
            return 1
          }
        fi
        ;;
    esac
  done

  dbus_candidates=$( { printf '%s\n' "$services_raw"; printf '%s\n' "$service_unit_files"; } \
    | awk 'NF > 0 { print $1 }' | sort -u) || {
    active_units=unknown
    return 1
  }
  for unit in $dbus_candidates; do
    if systemd_service_is_dbus_activatable "$unit"; then
      if service_invokes_packaged_runner "$unit"; then
        append_active_unit "dbus-activatable($unit)"
      else
        query_status=$?
        [ "$query_status" -eq 2 ] || {
          active_units=unknown
          return 1
        }
      fi
    else
      query_status=$?
      [ "$query_status" -eq 1 ] || {
        active_units=unknown
        return 1
      }
    fi
  done

  if dbus_activation_service_files_safe; then
    :
  else
    activation_scan_status=$?
    [ "$activation_scan_status" -eq 1 ] || active_units=unknown
    append_active_unit "dbus-activation-service-file"
    return 1
  fi

  for candidate in $active_timers; do
    timer=${candidate%|*}
    state=${candidate##*|}
    case "$timer" in
      velnor*)
        if scheduled_oneshot_under_transaction_lock "$timer"; then
          continue
        fi
        append_active_unit "$timer($state)"
        ;;
      *)
        triggers=$(systemd_property "$timer" Triggers) || {
          active_units=unknown
          return 1
        }
        for target in $triggers; do
          case "$target" in
            *.service)
              case "$target" in
                velnor*)
                  append_active_unit "$timer($state)->$target"
                  ;;
                *)
                  if service_invokes_packaged_runner "$target"; then
                    append_active_unit "$timer($state)->$target"
                  else
                    query_status=$?
                    [ "$query_status" -eq 2 ] || {
                      active_units=unknown
                      return 1
                    }
                  fi
                  ;;
              esac
              ;;
          esac
        done
        ;;
    esac
  done

  for activation_kind in socket path; do
    activation_raw=$(systemctl list-units --all --type="$activation_kind" \
      --no-legend --no-pager --plain --full 2>/dev/null) || {
      active_units=unknown
      return 1
    }
    active_activations=$(printf '%s\n' "$activation_raw" | awk -v suffix=".$activation_kind" '
      NF == 0 { next }
      NF < 4 || index($1, suffix) != length($1) - length(suffix) + 1 \
        || $2 == "" || $4 == "" \
        || $3 !~ /^(active|reloading|inactive|failed|activating|deactivating|maintenance)$/ {
        malformed = 1
        next
      }
      $3 != "inactive" && $3 != "failed" { print $1 "|" $3 }
      END { if (malformed) exit 1 }
    ') || {
      active_units=unknown
      return 1
    }
    for candidate in $active_activations; do
      activation=${candidate%|*}
      state=${candidate##*|}
      append_active_unit "$activation($state)"
    done
  done

  # Manager.ListJobs is one snapshot of queued jobs, not an activation fence:
  # systemd can accept work immediately after it returns. The shared package
  # lock fences every shipped ExecStart before runner work; this snapshot and
  # the final unit/process scans add extra detection for work already in flight.
  if ! verify_pending_systemd_activation_jobs; then
    [ -n "$active_units" ] || active_units=unknown
    return 1
  fi

  services_after_reload_raw=$(systemctl list-units --all --type=service \
    --no-legend --no-pager --plain --full 2>/dev/null) || {
    active_units=unknown
    return 1
  }
  active_services_after_reload=$(printf '%s\n' "$services_after_reload_raw" | awk '
    NF == 0 { next }
    NF < 4 || $1 !~ /\.service$/ || $2 == "" || $4 == "" \
      || $3 !~ /^(active|reloading|inactive|failed|activating|deactivating|maintenance)$/ {
      malformed = 1
      next
    }
    $3 != "inactive" && $3 != "failed" { print $1 "|" $3 }
    END { if (malformed) exit 1 }
  ') || {
    active_units=unknown
    return 1
  }
  for candidate in $active_services_after_reload; do
    unit=${candidate%|*}
    state=${candidate##*|}
    case "$unit" in
      velnor*)
        if scheduled_oneshot_under_transaction_lock "$unit"; then
          continue
        fi
        append_active_unit "$unit($state)"
        ;;
      *)
        if service_invokes_packaged_runner "$unit"; then
          append_active_unit "$unit($state)"
        else
          query_status=$?
          [ "$query_status" -eq 2 ] || {
            active_units=unknown
            return 1
          }
        fi
        ;;
    esac
  done

  if [ -n "$active_units" ]; then
    return 1
  fi
  if ! no_live_packaged_runner_process; then
    active_units=live-velnor-runner-process
    return 1
  fi
  return 0
}
microvm_verify_sha256() {
  file="$1"
  field="$2"
  path="$SHARE/microvm/$file"
  manifest="$SHARE/microvm/manifest.json"
  want=$(sed -n "s/.*\"$field\": *\"\\([0-9a-fA-F]\\{64\\}\\)\".*/\\1/p" "$manifest" | head -n1 | tr 'A-F' 'a-f')
  [ -n "$want" ] || fail "microvm manifest missing $field sha256"
  got=$(sha256sum "$path" | awk '{print $1}')
  [ "$got" = "$want" ] || fail "microvm $file sha256 $got != manifest $want"
}

verify_package_identity() {
  [ -x "$BIN" ] || fail "installed runner binary is missing or not executable"
  [ -f "$SHARE/build-identity.json" ] && [ ! -L "$SHARE/build-identity.json" ] \
    || fail "shipped build-identity.json is missing or not a regular file"
  [ -f "$SHARE/manifest.json" ] && [ ! -L "$SHARE/manifest.json" ] \
    || fail "shipped manifest.json is missing or not a regular file"

  installed_identity=$("$BIN" release export) \
    || fail "installed runner could not export its compiled identity"
  installed_sha=$(printf '%s\n' "$installed_identity" \
    | sed -n 's/.*"source_sha": *"\([0-9a-f]\{40\}\)".*/\1/p' | head -n1)
  installed_crate_version=$(printf '%s\n' "$installed_identity" \
    | sed -n 's/.*"crate_version": *"\([^"]*\)".*/\1/p' | head -n1)
  shipped_sha=$(sed -n 's/.*"source_sha": *"\([0-9a-f]\{40\}\)".*/\1/p' \
    "$SHARE/build-identity.json" | head -n1)
  shipped_crate_version=$(sed -n 's/.*"crate_version": *"\([^"]*\)".*/\1/p' \
    "$SHARE/build-identity.json" | head -n1)
  shipped_debian_version=$(sed -n 's/.*"debian_version": *"\([^"]*\)".*/\1/p' \
    "$SHARE/build-identity.json" | head -n1)
  shipped_manifest_sha=$(sed -n 's/.*"manifest_sha256": *"\([0-9a-fA-F]\{64\}\)".*/\1/p' \
    "$SHARE/build-identity.json" | head -n1 | tr 'A-F' 'a-f')
  [ -n "$installed_sha" ] && [ -n "$shipped_sha" ] \
    || fail "compiled/package source SHA is missing"
  [ "$installed_sha" = "$shipped_sha" ] \
    || fail "installed binary source SHA does not match the packaged build identity"
  [ -n "$installed_crate_version" ] && [ -n "$shipped_crate_version" ] \
    || fail "compiled/package crate version is missing"
  [ "$installed_crate_version" = "$shipped_crate_version" ] \
    || fail "installed binary crate version does not match the packaged build identity"
  [ -n "$shipped_debian_version" ] \
    || fail "shipped build identity has no Debian package version"
  installed_package_version=$(dpkg-query -W -f='${Version}' velnor-runner 2>/dev/null) \
    || fail "could not read installed velnor-runner package version"
  [ -n "$installed_package_version" ] && [ "$installed_package_version" = "$shipped_debian_version" ] \
    || fail "installed Debian package version does not match the packaged build identity"
  [ -n "$shipped_manifest_sha" ] \
    || fail "shipped build identity has no compiled-manifest SHA-256"

  binary_manifest=$("$BIN" capabilities export) \
    || fail "installed runner could not export its compiled manifest"
  binary_manifest_sha=$(printf '%s\n' "$binary_manifest" | sha256sum | awk '{print $1}')
  shipped_manifest_file_sha=$(sha256sum "$SHARE/manifest.json" | awk '{print $1}') \
    || fail "could not hash the shipped capability manifest"
  [ "$binary_manifest_sha" = "$shipped_manifest_file_sha" ] \
    || fail "installed binary's compiled manifest does not match the packaged manifest"
  [ "$shipped_manifest_sha" = "$shipped_manifest_file_sha" ] \
    || fail "shipped manifest does not match the packaged build identity"

  MICROVM="$SHARE/microvm"
  if [ -f "$MICROVM/manifest.json" ]; then
    [ ! -L "$MICROVM/manifest.json" ] || fail "microvm manifest must be a regular file"
    [ -x "$MICROVM/firecracker" ] || fail "microvm firecracker missing from package identity"
    [ -x "$MICROVM/jailer" ] || fail "microvm jailer missing from package identity"
    [ -x "$MICROVM/velnor-guest-agent" ] || fail "microvm guest-agent missing from package identity"
    [ -f "$MICROVM/vmlinux" ] || fail "microvm vmlinux missing from package identity"
    [ -f "$MICROVM/rootfs.ext4" ] || fail "microvm rootfs.ext4 missing from package identity"
    microvm_verify_sha256 firecracker firecracker
    microvm_verify_sha256 jailer jailer
    microvm_verify_sha256 vmlinux kernel
    microvm_verify_sha256 rootfs.ext4 rootfs
    microvm_verify_sha256 velnor-guest-agent guest_agent
  fi
}

case "$1" in
  configure)
    require_package_transaction_lock
    [ -d /run/systemd/system ] \
      || fail "refusing package configuration without systemd: cannot prove daemon drain or effective roots for legacy purge"
    active_units=
    all_velnor_units_drained || fail "refusing package configuration: active or unverified Velnor service/timer unit(s) remain (${active_units:-unknown}). Stop the exact units first."

    # Complete every proof before package-owned mutations.
    verify_package_identity
    systemctl daemon-reload \
      || fail "systemd refused to reload before legacy storage root verification"
    "$BIN" storage verify-legacy \
      || fail "could not prove every configured daemon root before package mutation"

    # Keep the exact old drop-in until configure exits. The EXIT trap restores
    # it and reloads systemd if any later proof or purge fails.
    remove_stale_jobs_cpu_quota_dropin
    if [ -n "${JOBS_SLICE_DROPIN_BACKUP:-}" ]; then
      systemctl daemon-reload \
        || fail "systemd refused to reload after staging the stale quota drop-in"
    fi
    verify_jobs_slice_has_no_resource_ceilings

    # /run is tmpfs: recreate the transaction-lock path now (not only at boot)
    # so the documented flock wrapper works immediately after install/upgrade.
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/velnor-runner.conf
    install -d -m 0750 /var/lib/velnor /var/lib/velnor/work
    # Jailer chroot and writable disks must be exec-capable; /run is tmpfs noexec.
    install -d -m 0750 /var/lib/velnor/microvm /var/lib/velnor/microvm/jailer /var/lib/velnor/microvm/disks /var/lib/velnor/microvm/vsock
    install -d -m 0750 "$RELEASE_DIR" "$RELEASE_DIR/records"
    # Pre-010 packages may have left an empty concrete active directory. The
    # transactional store uses an atomically replaced active symlink instead.
    if [ -d "$ACTIVE_DIR" ] && [ ! -L "$ACTIVE_DIR" ]; then
      rmdir "$ACTIVE_DIR" 2>/dev/null \
        || fail "legacy active directory is nonempty; refusing pointer migration"
    fi

    if [ -f /etc/velnor/velnor.env ]; then
      chmod 0640 /etc/velnor/velnor.env || true
    fi
    # Secrets split (unchanged from prior behavior): migrate a real token out of
    # velnor.env into secrets.env (0600, never shipped/overwritten). Idempotent.
    if [ -f /etc/velnor/velnor.env ] && [ ! -f /etc/velnor/secrets.env ]; then
      token_line=$(grep '^GITHUB_TOKEN=..*' /etc/velnor/velnor.env || true)
      case "$token_line" in
        GITHUB_TOKEN=gh*|GITHUB_TOKEN=github_pat_*)
          umask 077
          printf '# Velnor secrets — owned by the operator, never touched by the package.\n%s\n' "$token_line" > /etc/velnor/secrets.env
          chmod 0600 /etc/velnor/secrets.env
          sed -i 's/^GITHUB_TOKEN=..*/GITHUB_TOKEN=/' /etc/velnor/velnor.env
          echo "Migrated GITHUB_TOKEN from velnor.env to /etc/velnor/secrets.env (0600)."
          ;;
      esac
    fi

    # Fleet unit enablement, masking, and activation belong to the operator.
    # Package upgrades preserve systemd's existing state for them; fresh
    # installs leave them disabled. In particular, never revive the obsolete
    # default daemon/doctor or invent doctors for inactive template instances.
    #
    # The scheduled store gc is the package's own hygiene, not fleet
    # activation: `velnor-cache-gc.timer` fires `velnorctl cache gc --yes`,
    # which enumerates every packaged instance itself and runs under the
    # shared package-transaction lock, so an enabled timer never blocks a
    # later upgrade (scheduled_oneshot_under_transaction_lock). Enable it on
    # install and on every upgrade; idempotent. An operator who masked the
    # timer has opted out, and a mask is honoured, never removed.
    case "$(systemctl is-enabled velnor-cache-gc.timer 2>/dev/null || true)" in
      masked|masked-runtime)
        echo "velnor-cache-gc.timer is masked; leaving the operator's opt-out in place"
        ;;
      *)
        systemctl enable --now velnor-cache-gc.timer \
          || fail "could not enable velnor-cache-gc.timer"
        ;;
    esac

    # The only data deletion runs after identity, effective-root, and slice
    # proofs plus package setup. The helper repeats manager/root checks and
    # acquires each instance's GC and filesystem coordinator locks.
    "$BIN" storage purge-legacy \
      || fail "could not safely purge stale trust-scope storage roots"

    echo "velnorctl (velnor-runner package) installed. NOTE: this package never restarts the fleet."
    echo "Configure /etc/velnor/secrets.env (0600) + /etc/velnor/velnor.env, then"
    echo "activate a coherent release and start:"
    echo "  sudo velnor-runner release activate --record <release-record.json>"
    echo "  sudo systemctl enable --now velnor-daemon@<name>  # operator-selected instance"
    echo "velnor-cache-gc.timer (weekly gc of every instance's stores) is enabled by the package."
    ;;
esac

exit 0
