#!/bin/sh
# Plan 010 — transactional host activation, post-unpack.
#
# This script NEVER builds an image and NEVER restarts a daemon. The old
# postinst rebuilt a mutable Dockerfile and `try-restart ... || true`, trusting a
# single mutable image label with no manifest/source/digest check and restarting
# before equality. That is replaced with: validate the installed binary against
# the shipped acyclic identity, and (if a release record is already staged) prove
# coherence against the package's own shipped identity. The active pointer is
# deliberately NOT checked here: during a drained upgrade it still names the
# exact rollback predecessor until the operator activates the new record.
# ExecStartPre fails closed on that temporary mismatch, so no daemon can start.
# Activation, image acquisition, and restart
# are a separate, explicit `velnorctl release activate` step run by the
# deployment flow, never here.
set -e

BIN=/usr/bin/velnor-runner
SHARE=/usr/share/velnor
RELEASE_DIR=/var/lib/velnor/release
ACTIVE_DIR=$RELEASE_DIR/active
PACKAGE_TRANSACTION_LOCK=/run/velnor/package-transaction.lock
JOBS_SLICE_DROPIN_DIR=/etc/systemd/system/velnor-jobs.slice.d
JOBS_SLICE_DROPIN=$JOBS_SLICE_DROPIN_DIR/10-host-cpu.conf

fail() {
  echo "velnor-runner postinst: $1" >&2
  exit 1
}

write_host_scaled_jobs_cpu_quota() {
  cpu_count=$(/usr/bin/getconf _NPROCESSORS_ONLN 2>/dev/null || true)
  case "$cpu_count" in
    ''|*[!0-9]*) fail "could not detect a positive online CPU count for velnor-jobs.slice" ;;
  esac
  [ "$cpu_count" -gt 0 ] || fail "online CPU count is zero for velnor-jobs.slice"
  cpu_quota=$((cpu_count * 95))
  [ "$cpu_quota" -gt 0 ] || fail "computed CPUQuota is invalid for velnor-jobs.slice"

  # Unit fragments are read from /etc so the generated host-specific value
  # overrides the immutable package unit. Same-directory rename makes a
  # package interruption leave the previous valid cap in place.
  install -d -m 0755 "$JOBS_SLICE_DROPIN_DIR"
  temporary="$JOBS_SLICE_DROPIN.tmp.$$"
  rm -f "$temporary"
  old_umask=$(umask)
  umask 022
  printf '%s\n' \
    "[Slice]" \
    "# Generated from the host online CPU count during package configuration." \
    "# CPUQuota is 95% of one CPU per online logical CPU." \
    "CPUQuota=${cpu_quota}%" > "$temporary"
  chmod 0644 "$temporary"
  mv -f "$temporary" "$JOBS_SLICE_DROPIN"
  umask "$old_umask"
}

require_package_transaction_lock() {
  # The deployment wrapper takes an exclusive lock on the path with --no-fork,
  # so the apt process itself remains the kernel lock owner through dpkg and
  # every maintainer script. Never accept a caller-controlled marker or acquire
  # a new lock here: a shared lock or an unrelated process must fail closed.
  lock_inode=$(stat -c '%i' "$PACKAGE_TRANSACTION_LOCK" 2>/dev/null || true)
  [ -n "$lock_inode" ] \
    || fail "refusing package configuration: cannot stat $PACKAGE_TRANSACTION_LOCK"
  lock_owner=$(awk -v inode="$lock_inode" '
    $2 == "FLOCK" {
      split($6, device_inode, ":")
      if (device_inode[3] == inode) {
        if ($4 != "WRITE") exit 2
        print $5
        exit
      }
    }' /proc/locks 2>/dev/null) || lock_owner=
  case "$lock_owner" in
    ''|*[!0-9]*) fail "refusing package configuration: no exclusive lock owner for $PACKAGE_TRANSACTION_LOCK" ;;
  esac
  current_pid=$$
  while [ "$current_pid" -gt 1 ]; do
    [ "$current_pid" = "$lock_owner" ] && return 0
    parent_pid=$(awk '$1 == "PPid:" { print $2; exit }' \
      "/proc/$current_pid/status" 2>/dev/null || true)
    case "$parent_pid" in
      ''|*[!0-9]*) break ;;
    esac
    [ "$parent_pid" = "$current_pid" ] && break
    current_pid=$parent_pid
  done
  fail "refusing package configuration: exclusive lock owner is not an apt-wrapper ancestor"
}

all_velnor_units_drained() {
  # Recheck under the verified outer lock immediately before any package-owned
  # filesystem or configuration side effect. Timers are included because an
  # active timer can start an old doctor during package unpack/configure.
  active_services_raw=$(systemctl list-units --type=service --all --no-legend --plain 'velnor*.service' 2>/dev/null) || return 1
  active_timers_raw=$(systemctl list-units --type=timer --all --no-legend --plain 'velnor*.timer' 2>/dev/null) || return 1
  active_units=$(printf '%s\n%s\n' "$active_services_raw" "$active_timers_raw" \
    | awk '$3 != "inactive" && $3 != "failed" {print $1 "(" $3 ")"}')
  [ -z "$active_units" ]
}

scoped_units_drained() {
  active_units=
  for unit in $VELNOR_DRAINED_UNITS; do
    case "$unit" in
      velnor*.service|velnor*.timer) ;;
      *) fail "refusing package configuration: invalid scoped unit name '$unit'" ;;
    esac
    state=$(systemctl show --property=ActiveState --value "$unit" 2>/dev/null || true)
    case "$state" in
      ''|inactive|failed) ;;
      *) active_units="$active_units ${unit}(${state})" ;;
    esac
  done
  [ -z "$active_units" ]
}

microvm_verify_sha256() {
  file="$1"
  field="$2"
  path="$SHARE/microvm/$file"
  manifest="$SHARE/microvm/manifest.json"
  want=$(sed -n "s/.*\"$field\": *\"\\([0-9a-fA-F]\\{64\\}\\)\".*/\\1/p" "$manifest" | head -n1 | tr 'A-F' 'a-f')
  [ -n "$want" ] || fail "microvm manifest missing $field sha256"
  got=$(sha256sum "$path" | awk '{print $1}')
  [ "$got" = "$want" ] || fail "microvm $file sha256 $got != manifest $want"
}

case "$1" in
  configure)
    require_package_transaction_lock
    if [ -d /run/systemd/system ]; then
      active_units=
      if [ -n "${VELNOR_DRAINED_UNITS:-}" ]; then
        scoped_units_drained || fail "refusing scoped package configuration: requested unit(s) remain active (${active_units:-unknown}). Stop the exact target units first."
      else
        all_velnor_units_drained || fail "refusing package configuration: active Velnor service/timer unit(s) remain (${active_units:-unknown}). Stop the exact units first."
      fi
    fi
    write_host_scaled_jobs_cpu_quota
    # /run is tmpfs: recreate the transaction-lock path now (not only at boot)
    # so the documented flock wrapper works immediately after install/upgrade.
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/velnor-runner.conf
    install -d -m 0750 /var/lib/velnor /var/lib/velnor/work
    # Jailer chroot and writable disks must be exec-capable; /run is tmpfs noexec.
    install -d -m 0750 /var/lib/velnor/microvm /var/lib/velnor/microvm/jailer /var/lib/velnor/microvm/disks /var/lib/velnor/microvm/vsock
    install -d -m 0750 "$RELEASE_DIR" "$RELEASE_DIR/records"
    # Pre-010 packages may have left an empty concrete active directory. The
    # transactional store uses an atomically replaced active symlink instead.
    if [ -d "$ACTIVE_DIR" ] && [ ! -L "$ACTIVE_DIR" ]; then
      rmdir "$ACTIVE_DIR" 2>/dev/null \
        || fail "legacy active directory is nonempty; refusing pointer migration"
    fi

    if [ -f /etc/velnor/velnor.env ]; then
      chmod 0640 /etc/velnor/velnor.env || true
    fi
    # Secrets split (unchanged from prior behavior): migrate a real token out of
    # velnor.env into secrets.env (0600, never shipped/overwritten). Idempotent.
    if [ -f /etc/velnor/velnor.env ] && [ ! -f /etc/velnor/secrets.env ]; then
      token_line=$(grep '^GITHUB_TOKEN=..*' /etc/velnor/velnor.env || true)
      case "$token_line" in
        GITHUB_TOKEN=gh*|GITHUB_TOKEN=github_pat_*)
          umask 077
          printf '# Velnor secrets — owned by the operator, never touched by the package.\n%s\n' "$token_line" > /etc/velnor/secrets.env
          chmod 0600 /etc/velnor/secrets.env
          sed -i 's/^GITHUB_TOKEN=..*/GITHUB_TOKEN=/' /etc/velnor/velnor.env
          echo "Migrated GITHUB_TOKEN from velnor.env to /etc/velnor/secrets.env (0600)."
          ;;
      esac
    fi

    # --- Identity validation (offline, no network, no build) ----------------
    # The installed binary's embedded source SHA + crate version MUST match the
    # acyclic identity shipped in the deb, and its compiled manifest MUST match
    # the shipped manifest export. This proves binary <-> package <-> manifest
    # coherence for exactly this deb before anything is activated.
    MICROVM="$SHARE/microvm"
    if [ -f "$MICROVM/manifest.json" ]; then
      [ -x "$MICROVM/firecracker" ] || fail "microvm firecracker missing from package identity"
      [ -x "$MICROVM/jailer" ] || fail "microvm jailer missing from package identity"
      [ -x "$MICROVM/velnor-guest-agent" ] || fail "microvm guest-agent missing from package identity"
      [ -f "$MICROVM/vmlinux" ] || fail "microvm vmlinux missing from package identity"
      [ -f "$MICROVM/rootfs.ext4" ] || fail "microvm rootfs.ext4 missing from package identity"
      microvm_verify_sha256 firecracker firecracker
      microvm_verify_sha256 jailer jailer
      microvm_verify_sha256 vmlinux kernel
      microvm_verify_sha256 rootfs.ext4 rootfs
      microvm_verify_sha256 velnor-guest-agent guest_agent
    fi

    if [ -x "$BIN" ] && [ -f "$SHARE/build-identity.json" ]; then
      installed_sha="$("$BIN" release export | sed -n 's/.*"source_sha": *"\([0-9a-f]*\)".*/\1/p' | head -n1)"
      shipped_sha="$(sed -n 's/.*"source_sha": *"\([0-9a-f]*\)".*/\1/p' "$SHARE/build-identity.json" | head -n1)"
      [ -n "$shipped_sha" ] || fail "shipped build-identity.json has no source_sha"
      [ "$installed_sha" = "$shipped_sha" ] \
        || fail "installed binary source SHA does not match the packaged build identity"
      if [ -f "$SHARE/manifest.json" ]; then
        binary_hash="$("$BIN" capabilities export | sha256sum | awk '{print $1}')"
        shipped_hash="$(sha256sum "$SHARE/manifest.json" | awk '{print $1}')"
        [ "$binary_hash" = "$shipped_hash" ] \
          || fail "installed binary's compiled manifest does not match the packaged manifest"
      fi
    fi

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload \
        || fail "systemd refused to reload the host-scaled velnor-jobs.slice quota"
      effective_unit=$(systemctl cat velnor-jobs.slice 2>/dev/null) \
        || fail "could not read the effective velnor-jobs.slice configuration"
      effective_cpu_quota_percent=$(printf '%s\n' "$effective_unit" \
        | sed -n 's/^[[:space:]]*CPUQuota=//p' | tail -n1)
      [ "$effective_cpu_quota_percent" = "${cpu_quota}%" ] \
        || fail "velnor-jobs.slice effective CPUQuota is '$effective_cpu_quota_percent', expected '${cpu_quota}%'"
      effective_cpu_quota=$(systemctl show \
        --property=CPUQuotaPerSecUSec --value velnor-jobs.slice 2>/dev/null) \
        || fail "could not read effective CPUQuota after daemon-reload"
      case "$effective_cpu_quota" in
        ''|infinity|Infinity|INFINITY)
          fail "no effective CPUQuota after daemon-reload"
          ;;
      esac
      expected_cpu_quota_usec=$((cpu_quota * 10000))
      effective_cpu_quota_usec=$(busctl get-property \
        org.freedesktop.systemd1 \
        /org/freedesktop/systemd1/unit/velnor_2djobs_2eslice \
        org.freedesktop.systemd1.Slice CPUQuotaPerSecUSec 2>/dev/null \
        | awk '$1 == "t" { print $2; exit }' || true)
      case "$effective_cpu_quota_usec" in
        ''|*[!0-9]*)
          fail "no effective CPUQuota after daemon-reload"
          ;;
      esac
      [ "$effective_cpu_quota_usec" = "$expected_cpu_quota_usec" ] \
        || fail "velnor-jobs.slice effective CPUQuotaPerSecUSec is '$effective_cpu_quota_usec', expected '$expected_cpu_quota_usec'"
      # Unit enablement, masking, and activation belong to the operator. Package
      # upgrades preserve systemd's existing state by doing nothing here; fresh
      # installs remain disabled. In particular, never revive the obsolete
      # default daemon/doctor or invent doctors for inactive template instances.
    fi

    echo "velnorctl (velnor-runner package) installed. NOTE: this package never restarts the fleet."
    echo "Configure /etc/velnor/secrets.env (0600) + /etc/velnor/velnor.env, then"
    echo "activate a coherent release and start:"
    echo "  sudo velnor-runner release activate --record <release-record.json>"
    echo "  sudo systemctl enable --now velnor-daemon@<name>  # operator-selected instance"
    ;;
esac

exit 0
