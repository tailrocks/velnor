[Unit]
Description=Velnor scheduled host cache garbage collection
Documentation=https://github.com/tailrocks/velnor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RuntimeDirectory=velnor
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# No EnvironmentFile and no --work-dir: `velnorctl cache gc` enumerates every
# packaged `velnor-daemon@<instance>` from /etc/velnor/<instance>.env and runs
# one pass per instance under that instance's own storage root and trust
# scope (velnor_runner::daemon_instance). Loading a single instance's env file
# here made every other instance's stores invisible to gc, and left trusted
# stores fail-closed because VELNOR_TRUST_SCOPE never reached this unit.
ExecStart=/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnorctl cache gc --yes
