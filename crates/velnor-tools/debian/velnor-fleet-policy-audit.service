[Unit]
Description=Velnor read-only fleet-policy audit (all orgs, sequential)
Documentation=https://github.com/tailrocks/velnor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RuntimeDirectory=velnor
RuntimeDirectoryMode=0750
Environment=VELNOR_FLEET_POLICY_DIR=/var/lib/velnor/fleet-policy
EnvironmentFile=/etc/velnor/fleet-policy-audit.env
EnvironmentFile=-/etc/velnor/secrets.env
# Read-only live audit ONLY: this unit never invokes plan-with-write or apply.
# Organizations are audited sequentially from VELNOR_FLEET_ORGS (config-driven);
# the first drift exits nonzero and stops the remaining organizations.
# "$$" yields a literal shell "$" (systemd expands single "$" itself).
ExecStart=/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /bin/sh -c '[ -n "${VELNOR_FLEET_ORGS}" ] || { echo "VELNOR_FLEET_ORGS is empty; refusing no-op audit" >&2; exit 2; }; for org in ${VELNOR_FLEET_ORGS}; do /usr/bin/velnor-tools fleet-policy audit --policy "${VELNOR_FLEET_POLICY_DIR}/$${org}-desired-policy.json" --ledger /usr/share/velnor/fleet/release-refs.toml --organization "$$org" || exit $?; done'
