{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "commitBody": "Signed-off-by: Renovate Bot <renovate@whitesourcesoftware.com>",
  "recreateWhen": "always",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Rust toolchain patch releases are frequently compiler-correctness backports (1.97.1, 1.98.1). Keep every pin site in one PR and never delay it.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "rust-lang/rust"
      ],
      "groupName": "rust toolchain",
      "minimumReleaseAge": null,
      "internalChecksFilter": "none"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "mise tool pins in the job image Dockerfile (mise use --global ...)",
      "managerFilePatterns": [
        "/^docker\\/job-ubuntu\\.Dockerfile$/"
      ],
      "matchStrings": [
        "'cargo:cargo-nextest@(?<currentValue>[0-9.]+)'"
      ],
      "datasourceTemplate": "crate",
      "depNameTemplate": "cargo-nextest"
    },
    {
      "customType": "regex",
      "description": "rust-script pin in the job image Dockerfile",
      "managerFilePatterns": [
        "/^docker\\/job-ubuntu\\.Dockerfile$/"
      ],
      "matchStrings": [
        "'cargo:rust-script@(?<currentValue>[0-9.]+)'"
      ],
      "datasourceTemplate": "crate",
      "depNameTemplate": "rust-script"
    },
    {
      "customType": "regex",
      "description": "just pin in the job image Dockerfile",
      "managerFilePatterns": [
        "/^docker\\/job-ubuntu\\.Dockerfile$/"
      ],
      "matchStrings": [
        "\\bjust@(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "casey/just"
    },
    {
      "customType": "regex",
      "description": "protoc pin in the job image Dockerfile",
      "managerFilePatterns": [
        "/^docker\\/job-ubuntu\\.Dockerfile$/"
      ],
      "matchStrings": [
        "\\bprotoc@(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "protocolbuffers/protobuf",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "gh CLI pin in the job image Dockerfile",
      "managerFilePatterns": [
        "/^docker\\/job-ubuntu\\.Dockerfile$/"
      ],
      "matchStrings": [
        "\\bgh@(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cli/cli",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "sccache pin in the job image Dockerfile",
      "managerFilePatterns": [
        "/^docker\\/job-ubuntu\\.Dockerfile$/"
      ],
      "matchStrings": [
        "ver=\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "mozilla/sccache",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "mise installer pin in the job image Dockerfile",
      "managerFilePatterns": [
        "/^docker\\/job-ubuntu\\.Dockerfile$/"
      ],
      "matchStrings": [
        "MISE_VERSION=\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Rust stable toolchain channel: rust-toolchain.toml is the single source of truth, and every mise lockfile mirrors the resolved version. All four sites must move together or the built artifact diverges from the declared toolchain.",
      "managerFilePatterns": [
        "/^rust-toolchain\\.toml$/",
        "/^mise\\.lock$/",
        "/^docker\\/build-mise\\.lock$/",
        "/^docker\\/job-mise\\.lock$/",
        "/^content\\/docs\\/guides\\/development\\.mdx$/"
      ],
      "matchStrings": [
        "channel = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "toolchain is Rust (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "\\[\\[tools\\.rust\\]\\]\\s+version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "\\[\\[tools\\.rust\\]\\]\\s+version = \"\\d+\\.\\d+\\.\\d+\"\\s+backend = \"core:rust\"\\s+specifiers = \\[\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\]"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rust-lang/rust",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "hadolint pin in the job image Dockerfile",
      "managerFilePatterns": [
        "/^docker\\/job-ubuntu\\.Dockerfile$/"
      ],
      "matchStrings": [
        "hadolint_ver=\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hadolint/hadolint",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "cosign pin in the job image Dockerfile",
      "managerFilePatterns": [
        "/^docker\\/job-ubuntu\\.Dockerfile$/"
      ],
      "matchStrings": [
        "cosign_ver=\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sigstore/cosign",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
