[Unit]
Description=Velnor controller for GitHub scope %i
Documentation=https://github.com/tailrocks/velnor
After=network-online.target velnor-guardian.service
Wants=network-online.target velnor-guardian.service
# Do not PartOf= slots or jobs: a controller restart must not stop workers.

[Service]
Type=notify
WatchdogSec=30
TimeoutStartSec=0
Slice=velnor-control.slice
Environment=VELNOR_CAPABILITY_VALIDATION=strict
EnvironmentFile=/etc/velnor/velnor.env
EnvironmentFile=-/etc/velnor/secrets.env
ExecStartPre=/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnor-runner release verify-installed
ExecStart=/usr/bin/flock --shared --no-fork /run/velnor/package-transaction.lock /usr/bin/velnor-runner controller --state-dir /var/lib/velnor --scope %i --desired-ready ${VELNOR_SLOTS}
Restart=always
RestartSec=5
TimeoutStopSec=120
KillMode=mixed
User=root
StateDirectory=velnor
RuntimeDirectory=velnor
LogsDirectory=velnor
WorkingDirectory=/var/lib/velnor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/velnor /run/velnor /var/log/velnor

[Install]
WantedBy=multi-user.target
