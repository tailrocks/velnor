[Unit]
Description=Velnor self-hosted GitHub Actions runner daemon (%i)
Documentation=https://github.com/tailrocks/velnor
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
# Template instance: one daemon per target scope (repo/org), e.g.
#   systemctl enable --now velnor-daemon@blockchain-nodes
# reads /etc/velnor/blockchain-nodes.env (+ optional
# /etc/velnor/blockchain-nodes.secrets.env for the token) and keeps state in
# /var/lib/velnor-blockchain-nodes. See velnor-daemon.service for the
# semantics of Type=notify/WatchdogSec and the never-exit retry behavior.
Type=notify
WatchdogSec=180
# Registration intentionally retries through transient GitHub/network failures
# and large fleets provision slots before READY=1. The systemd default 90s
# startup timeout can therefore kill a healthy daemon mid-registration.
TimeoutStartSec=0
Environment=VELNOR_JOB_CPUS=4
Environment=VELNOR_JOB_MEMORY=12g
Environment=VELNOR_STORAGE_ROOT=/var
# Strict capability admission is the only supported mode. The daemon refuses to
# start if this is set to anything else or if a removed bypass variable is
# present. Do not override this in the instance env file.
Environment=VELNOR_CAPABILITY_VALIDATION=strict
EnvironmentFile=/etc/velnor/%i.env
EnvironmentFile=-/etc/velnor/%i.secrets.env
# Plan 010: prove installed binary/package/manifest coherence with the active
# release record before start; a missing/mismatched tuple fails closed so a
# mixed old/new tuple never runs.
ExecStartPre=/usr/bin/velnorctl release verify-installed
ExecStart=/usr/bin/velnorctl daemon \
  --url ${VELNOR_URL} \
  --name ${VELNOR_NAME} \
  --labels ${VELNOR_LABELS} \
  --slots ${VELNOR_SLOTS} \
  --work-dir ${VELNOR_WORK_DIR} \
  --replace \
  --require-docker-socket
Restart=always
RestartSec=5
# Graceful drain: on stop/restart (including apt upgrades) the daemon finishes
# running jobs and deregisters idle slots instead of dying mid-job (incident
# 2026-06-11: an upgrade restart killed 7 in-flight jobs). The stop timeout
# bounds the longest job we wait for (3h, matching the estate's largest
# timeout-minutes); systemd escalates to SIGKILL after that.
TimeoutStopSec=10800
# KillMode=mixed: SIGTERM goes to the main PID only, so the graceful drain
# above never kills in-flight step children (docker exec, upload curls) as a
# side effect — that produced silently "successful" skipped steps and lost
# artifact uploads (tailrocks/velnor#311). systemd SIGKILLs the whole cgroup
# only after TimeoutStopSec expires.
KillMode=mixed
User=root
StateDirectory=velnor-%i
CacheDirectory=velnor
RuntimeDirectory=velnor
LogsDirectory=velnor
WorkingDirectory=/var/lib/velnor-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Per-instance state, work, and forensic logs all live below this root.
# JIT slot credentials remain under the root user's configured runner state.
ReadWritePaths=/var/lib/velnor-%i /var/cache/velnor /run/velnor /var/log/velnor /root/.velnor/runner

[Install]
WantedBy=multi-user.target
