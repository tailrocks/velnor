      - name: Restore mold 2.42.0 cache
        id: mold-cache
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/velnor/mold/2.42.0
