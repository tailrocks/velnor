        id: cargo-bin-verify
        shell: bash
        env:
          CARGO_BIN_TOOLS: ${{ inputs.cargo_bin_tools }}
        run: |
          set -euo pipefail
          missing=0
          IFS=',' read -ra tools <<< "$CARGO_BIN_TOOLS"
          for tool in "${tools[@]}"; do
            tool="${tool#"${tool%%[![:space:]]*}"}"
            tool="${tool%"${tool##*[![:space:]]}"}"
            [[ -z "$tool" ]] && continue
            if ! command -v "$tool" >/dev/null; then
              missing=1
              break
            fi
            if ! "$tool" --version >/dev/null 2>&1; then
              missing=1
              break
            fi
            if [[ "$tool" == cargo-* ]]; then
