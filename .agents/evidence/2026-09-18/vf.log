            if (set -C; printf '%s\n' "$(date +%s)" > "$marker") 2>/dev/null; then
              chmod 0444 "$marker" 2>/dev/null || true
            fi
          fi
      - name: Report phase timings and cache outcomes
        if: always()
        uses: tailrocks/velnor/.github/actions/report-velnor-ci-outcomes@bde4d4ecb1e4ddc40c6426b93e2c19e9d927a70d
        with:
          job_label: ${{ inputs.unit }}
          ci_provider: github-self-hosted

