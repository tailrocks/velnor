name: CI / Main
run-name: CI / main · ${{ github.event_name }} · ${{ github.ref_name }}

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      providers:
        description: Comma-separated provider subset of [github-hosted, github-self-hosted, velnor]
        required: false
        default: github-hosted,github-self-hosted,velnor
        type: string
      scope:
        description: Verification scope
        required: true
        default: full
