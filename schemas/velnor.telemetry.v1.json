{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velnor.dev/schemas/velnor.telemetry.v1.json",
  "title": "Velnor telemetry envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "lane",
    "repo",
    "trust_domain",
    "event",
    "ts_logical",
    "ts_wall",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "velnor.telemetry.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "action_key_digest": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "lane": {
      "enum": ["github", "velnor"]
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "trust_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "event": {
      "enum": [
        "run_queued",
        "run_admitted",
        "tool_prep",
        "cache_lookup",
        "compile_start",
        "compile_end",
        "link_end",
        "test_end",
        "artifact_materialize",
        "passive_wait",
        "critical_path",
        "plan_summary",
        "no_progress",
        "lease_acquired",
        "lease_renewed",
        "lease_released",
        "lease_abandoned",
        "lease_expired",
        "supersession_adopted",
        "consumer_detached",
        "retained_then_reaped",
        "retention_kill_skipped",
        "trust_revoked"
      ]
    },
    "ts_logical": {
      "type": "integer",
      "minimum": 0
    },
    "ts_wall": {
      "type": "string",
      "format": "date-time"
    },
    "fields": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "run_queued"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/run_queued_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "run_admitted"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/run_admitted_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "tool_prep"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/tool_prep_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "cache_lookup"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/cache_lookup_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "compile_start"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/compile_start_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "compile_end"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/compile_end_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "link_end"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/link_end_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "test_end"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/test_end_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "artifact_materialize"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/artifact_materialize_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "passive_wait"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/passive_wait_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "critical_path"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/critical_path_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "plan_summary"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/plan_summary_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "no_progress"}}},
      "then": {"properties": {"fields": {"$ref": "#/$defs/no_progress_fields"}}}
    },
    {
      "if": {"properties": {"event": {"const": "lease_acquired"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/lease_acquired_fields"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "lease_renewed"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/lease_renewed_fields"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "lease_released"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/lease_released_fields"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "lease_abandoned"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/lease_abandoned_fields"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "lease_expired"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/lease_expired_fields"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "supersession_adopted"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/supersession_adopted_fields"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "consumer_detached"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/consumer_detached_fields"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "retained_then_reaped"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/retained_then_reaped_fields"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "retention_kill_skipped"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/retention_kill_skipped_fields"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "trust_revoked"}}},
      "then": {
        "required": ["action_key_digest"],
        "properties": {
          "lane": {"const": "velnor"},
          "fields": {"$ref": "#/$defs/trust_revoked_fields"}
        }
      }
    }
  ],
  "$defs": {
    "run_queued_fields": {
      "type": "object",
      "required": ["queued_for_ms", "queue_time_present"],
      "properties": {
        "queued_for_ms": {"type": "integer", "minimum": 0},
        "queue_time_present": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "run_admitted_fields": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": true
    },
    "tool_prep_fields": {
      "type": "object",
      "required": ["ms", "tool"],
      "properties": {
        "ms": {"type": "integer", "minimum": 0},
        "tool": {"type": "string"}
      },
      "additionalProperties": true
    },
    "cache_lookup_fields": {
      "type": "object",
      "required": ["hit", "lookup_ms", "store"],
      "properties": {
        "hit": {"type": "boolean"},
        "lookup_ms": {"type": "integer", "minimum": 0},
        "store": {"type": "string"},
        "miss_reason": {"type": "string"},
        "physical_bytes_known": {"type": "boolean"},
        "shared_bytes": {"type": "integer", "minimum": 0},
        "newly_allocated_bytes": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {
            "required": ["physical_bytes_known"],
            "properties": {"physical_bytes_known": {"const": true}}
          },
          "then": {"required": ["shared_bytes", "newly_allocated_bytes"]}
        },
        {
          "if": {
            "required": ["physical_bytes_known"],
            "properties": {"physical_bytes_known": {"const": false}}
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["shared_bytes"]},
                {"required": ["newly_allocated_bytes"]}
              ]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {"required": ["shared_bytes"]},
              {"required": ["newly_allocated_bytes"]}
            ]
          },
          "then": {
            "required": ["physical_bytes_known"],
            "properties": {"physical_bytes_known": {"const": true}}
          }
        }
      ],
      "additionalProperties": true
    },
    "compile_start_fields": {
      "type": "object",
      "required": [
        "compiler",
        "metrics_known",
        "unit_count",
        "wrapper_calls",
        "hits",
        "misses"
      ],
      "properties": {
        "compiler": {"type": "string"},
        "metrics_known": {"type": "boolean"},
        "unit_count": {"type": "integer", "minimum": 0},
        "wrapper_calls": {"type": "integer", "minimum": 0},
        "hits": {"type": "integer", "minimum": 0},
        "misses": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "compile_end_fields": {
      "type": "object",
      "required": [
        "compiler",
        "exit_code",
        "metrics_known",
        "ms",
        "unit_count",
        "wrapper_calls",
        "hits",
        "misses"
      ],
      "properties": {
        "compiler": {"type": "string"},
        "exit_code": {"type": "integer"},
        "metrics_known": {"type": "boolean"},
        "ms": {"type": "integer", "minimum": 0},
        "unit_count": {"type": "integer", "minimum": 0},
        "wrapper_calls": {"type": "integer", "minimum": 0},
        "hits": {"type": "integer", "minimum": 0},
        "misses": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "link_end_fields": {
      "type": "object",
      "required": ["elapsed_ms", "exit_code", "runner_kind", "success"],
      "properties": {
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "exit_code": {"type": "integer"},
        "runner_kind": {"type": "string"},
        "success": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "test_end_fields": {
      "type": "object",
      "required": ["exit_code", "ms", "passed", "runner"],
      "properties": {
        "exit_code": {"type": "integer"},
        "ms": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"},
        "runner": {"type": "string"}
      },
      "additionalProperties": true
    },
    "artifact_materialize_fields": {
      "type": "object",
      "required": ["digest", "ms", "subset"],
      "properties": {
        "digest": {"type": "string"},
        "ms": {"type": "integer", "minimum": 0},
        "subset": {"type": "string"},
        "physical_bytes_known": {"type": "boolean"},
        "shared_bytes": {"type": "integer", "minimum": 0},
        "newly_allocated_bytes": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {
            "required": ["physical_bytes_known"],
            "properties": {"physical_bytes_known": {"const": true}}
          },
          "then": {"required": ["shared_bytes", "newly_allocated_bytes"]}
        },
        {
          "if": {
            "required": ["physical_bytes_known"],
            "properties": {"physical_bytes_known": {"const": false}}
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["shared_bytes"]},
                {"required": ["newly_allocated_bytes"]}
              ]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {"required": ["shared_bytes"]},
              {"required": ["newly_allocated_bytes"]}
            ]
          },
          "then": {
            "required": ["physical_bytes_known"],
            "properties": {"physical_bytes_known": {"const": true}}
          }
        }
      ],
      "additionalProperties": true
    },
    "passive_wait_fields": {
      "type": "object",
      "required": ["cause", "ms"],
      "properties": {
        "cause": {"type": "string"},
        "ms": {"type": "integer", "minimum": 0},
        "stage": {"type": "string"},
        "wait_reason": {"type": "string"},
        "stage_started_unix_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "critical_path_fields": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": true
    },
    "plan_summary_fields": {
      "type": "object",
      "required": [
        "counts_scope",
        "planner_dimensions_scope",
        "planner_dimensions_known",
        "duplicates_prevented",
        "selection_reasons",
        "logical_tasks",
        "physical_actions",
        "counts_capped"
      ],
      "properties": {
        "counts_scope": {"type": "string"},
        "planner_dimensions_scope": {"type": "string"},
        "planner_dimensions_known": {"type": "boolean"},
        "duplicates_prevented": {"type": "integer", "minimum": 0},
        "selection_reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "logical_tasks": {"type": "integer", "minimum": 0},
        "physical_actions": {"type": "integer", "minimum": 0},
        "counts_capped": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "no_progress_fields": {
      "type": "object",
      "required": ["window_ms", "last_event"],
      "properties": {
        "window_ms": {"type": "integer", "minimum": 0},
        "last_event": {"type": "string"}
      },
      "additionalProperties": true
    },
    "lease_acquired_fields": {
      "type": "object",
      "required": ["generation", "logical_ms"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "logical_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "lease_renewed_fields": {
      "type": "object",
      "required": ["generation", "logical_ms"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "logical_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "lease_released_fields": {
      "type": "object",
      "required": ["generation", "logical_ms"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "logical_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "lease_abandoned_fields": {
      "type": "object",
      "required": ["generation", "logical_ms"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "logical_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "lease_expired_fields": {
      "type": "object",
      "required": ["generation", "logical_ms"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "logical_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "supersession_adopted_fields": {
      "type": "object",
      "required": ["live_consumers"],
      "properties": {
        "live_consumers": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"},
        "retained_until_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "consumer_detached_fields": {
      "type": "object",
      "required": ["live_consumers"],
      "properties": {
        "live_consumers": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"},
        "retained_until_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "retained_then_reaped_fields": {
      "type": "object",
      "required": ["live_consumers"],
      "properties": {
        "live_consumers": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"},
        "retained_until_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "retention_kill_skipped_fields": {
      "type": "object",
      "required": ["live_consumers"],
      "properties": {
        "live_consumers": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"},
        "retained_until_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "trust_revoked_fields": {
      "type": "object",
      "required": ["live_consumers"],
      "properties": {
        "live_consumers": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"},
        "retained_until_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
